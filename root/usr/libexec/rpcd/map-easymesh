-- reset MAP keys in a scope back to their defaults (snapshot + rollback)
local function reset(args)
	args = args or {}
	local scope = tostring(args.scope or "")
	local per_file = {}
	for _, id in ipairs(FIELD_IDS) do
		local f = FIELDS[id]
		if f and f.d ~= nil then
			local g = FIELD_GROUPS[id] or ""
			if scope == "all" or g == scope then
				per_file[f.file] = per_file[f.file] or {}
				per_file[f.file][f.key] = f.d
			end
		end
	end
	if next(per_file) == nil then
		return { ok = false, error = "没有可重置的字段（scope: " .. (scope == "" and "空" or scope) .. "）" }
	end
	local originals = {}
	for file in pairs(per_file) do
		local t = file_text(file)
		if not t then return { ok = false, error = "配置文件缺失: " .. file } end
		originals[file] = t
	end
	local written = {}
	for file, updates in pairs(per_file) do
		local r = apply_kv(file, updates)
		if not r.ok then
			for _, f2 in ipairs(written) do
				write_atomic(FILE_PATHS[f2] or (MAP_DIR .. "/" .. f2), originals[f2])
			end
			return r
		end
		written[#written + 1] = file
	end
	local okr, results, warn = reload_services()
	if not okr then
		for _, f2 in ipairs(written) do
			write_atomic(FILE_PATHS[f2] or (MAP_DIR .. "/" .. f2), originals[f2])
		end
		return { ok = false, error = "服务重载失败，配置已回滚", rollback = true, results = results }
	end
	return { ok = true, scope = scope, files = written, results = results, warn = warn }
end

