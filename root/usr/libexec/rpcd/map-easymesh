local function fields_meta()
	local meta = {}
	for _, id in ipairs(FIELD_IDS) do
		local f = FIELDS[id]
		if f then
			local m = { id = id, type = f.type, label = f.label, group = FIELD_GROUPS[id] or "其他" }
			if f.secret then m.secret = true end
			if f.type == "enum" then
				local opts, seen = {}, {}
				local function push(v, label)
					if not seen[v] then seen[v] = true; opts[#opts + 1] = { value = v, label = label } end
				end
				if f.labels then
					if f.enum_sort then
						for _, v in ipairs(f.enum_sort) do if f.labels[v] then push(v, f.labels[v]) end end
					end
					for _, v in pairs(f.map) do if f.labels[v] then push(v, f.labels[v]) end end
				else
					push("0", "停用")
					push("1", "启用")
				end
				m.options = opts
			end
			if f.type == "int" then m.min = f.min; m.max = f.max end
			if f.type == "string" or f.type == "mac" then m.len = 64 end
			meta[#meta + 1] = m
		end
	end
	return meta
end

local function capabilities()
	local writable = fs.access(MAP_DIR, "w")
	local writable_fields, missing = {}, {}
	for id, f in pairs(FIELDS) do
		local st = field_state(id)
		local w = writable and st and st.present
		if w then writable_fields[id] = true else missing[#missing + 1] = id end
	end
	local wc = bin("wappctrl")
	return {
		ok = true,
		wappctrl = wc ~= nil,
		iface = first_wifi_iface(),
		config_present = fs.access(MAP_DIR .. "/mapd_cfg") ~= nil or fs.access(MAP_DIR .. "/1905d.cfg") ~= nil,
		writable = writable,
		writable_fields = writable_fields,
		missing_fields = missing,
		fields_meta = fields_meta(),
		groups = GROUP_ORDER,
		services = service_states(),
		note = "仅写入已探测到的白名单配置键（mapd_cfg / 1905d.cfg），写入前快照、失败自动回滚；拓扑查询只读使用 wappctrl get map_devices。",
	}
