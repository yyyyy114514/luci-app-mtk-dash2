local function set_role(a) return set_field({ field = "role", value = a and a.value, reload = a and a.reload }) end
local function set_backhaul(a) return set_field({ field = "backhaul", value = a and a.value, reload = a and a.reload }) end
local function set_policy(a) return set_field({ field = "steer", value = a and a.value, reload = a and a.reload }) end

local function reload()
	local okr, results = reload_services()
	return { ok = okr, results = results }
end

