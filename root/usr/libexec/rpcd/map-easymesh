local function set_field(args)
	args = args or {}
	local id = args.field
	local f = id and FIELDS[id]
	if not f then return { ok = false, error = "未知字段: " .. tostring(id) } end
	local path = FILE_PATHS[f.file] or (MAP_DIR .. "/" .. f.file)
	local text = read(path)
	if not text then return { ok = false, error = "配置文件缺失: " .. path } end
	if text:find("\r") then return { ok = false, error = "配置文件含 CRLF 换行，拒绝改写" } end
	local cur_line
	for _, ln in ipairs(parse_file(text)) do
		if ln.kind == "kv" and ln.key:lower() == f.key:lower() then cur_line = ln break end
	end
	local append_mode = cur_line == nil
	if append_mode then
		if not f.optional then
			return { ok = false, error = "配置中不存在键 " .. f.key .. "（固件版本可能不同）" }
		end
		if type(args.value) ~= "string" or args.value == "" then
			return { ok = true, unchanged = true }
		end
	end
	local cur = cur_line and stripq(cur_line.value) or ""
	local nv
	if f.secret then
		local raw = args.value
		if type(raw) ~= "string" or raw == "" then
			return { ok = false, error = "未提供新密钥（留空表示不修改）" }
		end
		if raw == REDACTED or raw == "__unchanged__" then
			return { ok = false, error = "值未变化" }
		end
		if #raw < 8 or #raw > 63 then
			return { ok = false, error = "密钥需为 8-63 位" }
		end
		nv = raw
	elseif f.type == "enum" then
		local raw = args.value
		if type(raw) ~= "string" then return { ok = false, error = "缺少 value 参数" } end
		nv = f.map[raw] or f.map[raw:lower()]
		if not nv then
			local allowed = {}
			for k in pairs(f.map) do allowed[#allowed + 1] = k end
			table.sort(allowed)
			return { ok = false, error = "值不在白名单: " .. raw, allowed = allowed }
		end
	elseif f.type == "int" then
		local n = tonumber(args.value)
		if not n or n % 1 ~= 0 or n < f.min or n > f.max then
			return { ok = false, error = ("数值需为 %d-%d 之间的整数"):format(f.min, f.max) }
		end
		nv = tostring(n)
	elseif f.type == "string" then
		local raw = args.value
		if type(raw) ~= "string" then return { ok = false, error = "缺少 value 参数" } end
		raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if raw == "" or #raw > 64 then return { ok = false, error = "值需为 1-64 个字符" } end
		nv = raw
	elseif f.type == "mac" then
		local raw = args.value
		if type(raw) ~= "string" or not raw:match("^[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]$") then
			return { ok = false, error = "MAC 地址格式非法" }
		end
		nv = raw
	else
		return { ok = false, error = "不支持的字段类型" }
	end
	if not f.secret and cur == nv then return { ok = false, error = "值未变化（当前: " .. cur .. "）" } end
	-- keep original quoting style (mapd files are unquoted key=value)
	local openq, closeq = "", ""
	if cur_line and cur_line.value:sub(1, 1) == '"' then openq, closeq = '"', '"' end
	if cur_line and cur_line.value:sub(1, 1) == "'" then openq, closeq = "'", "'" end
	local snap = path .. ".mtk-rollback"
	local sf = io.open(snap, "wb")
	if not sf then return { ok = false, error = "无法创建回滚快照" } end
	sf:write(text)
	sf:close()
	local out_lines = {}
	for _, ln in ipairs(parse_file(text)) do
		if ln.kind == "kv" and ln.key:lower() == f.key:lower() then
			out_lines[#out_lines + 1] = ln.key .. "=" .. openq .. nv .. closeq
		else
			out_lines[#out_lines + 1] = ln.raw
		end
	end
	if append_mode then
		out_lines[#out_lines + 1] = f.key .. "=" .. nv
	end
	local content = table.concat(out_lines, "\n") .. "\n"
	local function rollback()
		local c = read(snap)
		if c then write_atomic(path, c) end
		os.remove(snap)
	end
	if not write_atomic(path, content) then
		rollback()
		return { ok = false, error = "配置写入失败，已回滚", rollback = true }
	end
	if (read(path) or "") ~= content then
		rollback()
		return { ok = false, error = "配置写入校验失败，已回滚", rollback = true }
	end
	if args.reload == true then
		local okr, results, warn = reload_services()
		if not okr then
			rollback()
			return { ok = false, error = "服务重载失败，配置已回滚", rollback = true, results = results }
		end
		os.remove(snap)
		return { ok = true, field = id, key = f.key, old = f.secret and "***" or cur, value = nv, file = path, reloaded = true, results = results, warn = warn }
	end
	os.remove(snap)
	return { ok = true, field = id, key = f.key, old = f.secret and "***" or cur, value = nv, file = path }
end

-- ---------------------------------------------------------------------------
-- shared helpers for wappctrl / iwpriv operations (all user input is
-- validated before it ever reaches a shell command line)
-- ---------------------------------------------------------------------------

local function v_iface(name)
	name = tostring(name or "")
	if not name:match("^[%w_.-]+$") or #name > 32 then return nil end
	if not fs.access("/sys/class/net/" .. name) then return nil end
	return name
end

local function v_apcli(name)
	name = tostring(name or "")
	if not name:match("^apclix?%d+$") then return nil end
	return name
end

local function v_mac(mac)
	mac = tostring(mac or "")
	if not mac:match("^[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]$") then return nil end
	return mac
end

local function v_uint(s)
	s = tostring(s or "")
	if not s:match("^[0-9]+$") then return nil end
	return s
end

local function v_id(s)
	s = tostring(s or "")
	if s == "*" or s:match("^[0-9]+$") then return s end
	return nil
end

local function v_text(s)
	s = tostring(s or "")
	if s == "" then return nil end
	if #s > 128 then return nil end
	if s:find("[%z\1-\31\127\"'\\`$]") then return nil end
	return s
end

-- pick the first wifi iface for daemon-facing commands (never hardcoded)
local function pick_iface(arg)
	local i = v_iface(arg)
	if i then return i end
	return first_wifi_iface()
end

-- execute `wappctrl <iface> <subcmd>`; returns (code, output)
local function wapp_cmd(iface, subcmd)
	local wc = bin("wappctrl")
	if not wc then return nil, "missing wappctrl" end
	local code, out = sh(q(wc) .. " " .. q(iface) .. " " .. subcmd)
	return code, out
end

local function wapp_ok(iface, subcmd)
	if not iface then return { ok = false, error = "no wifi iface" } end
	local code, out = wapp_cmd(iface, subcmd)
	if not code then return { ok = false, error = out or "missing wappctrl" } end
	if code ~= 0 then
		return { ok = false, error = clean(out):gsub("%s+$", ""), exit_code = code }
	end
	return { ok = true, output = clean(out):gsub("%s+$", ""), exit_code = code, iface = iface }
end

-- atomic multi-key update of one MAP kv file with snapshot + rollback
local function apply_kv(file, updates)
	local path = FILE_PATHS[file] or (MAP_DIR .. "/" .. file)
	local text = read(path)
	if not text then return { ok = false, error = "配置文件缺失: " .. path } end
	if text:find("\r") then return { ok = false, error = "配置文件含 CRLF 换行，拒绝改写" } end
	local snap = path .. ".mtk-rollback"
	local sf = io.open(snap, "wb")
	if not sf then return { ok = false, error = "无法创建回滚快照" } end
	sf:write(text)
	sf:close()
	local out_lines, done = {}, {}
	for _, ln in ipairs(parse_file(text)) do
		local replaced = false
		if ln.kind == "kv" then
			local lk = ln.key:lower()
			for k, v in pairs(updates) do
				if k:lower() == lk then
					out_lines[#out_lines + 1] = ln.key .. "=" .. v
					done[k] = true
					replaced = true
					break
				end
			end
		end
		if not replaced then out_lines[#out_lines + 1] = ln.raw end
	end
	for k, v in pairs(updates) do
		if not done[k] then out_lines[#out_lines + 1] = k .. "=" .. v end
	end
	local content = table.concat(out_lines, "\n") .. "\n"
	local function rollback()
		local c = read(snap)
		if c then write_atomic(path, c) end
		os.remove(snap)
	end
	if not write_atomic(path, content) then
		rollback()
		return { ok = false, error = "配置写入失败，已回滚", rollback = true }
	end
	if (read(path) or "") ~= content then
		rollback()
		return { ok = false, error = "配置写入校验失败，已回滚", rollback = true }
	end
	os.remove(snap)
	return { ok = true, file = file }
end

local AUTH_MODES = {
	OPEN = true, WPAPSK = true, WPA2PSK = true, WPA3PSK = true,
	WPAPSKWPA2PSK = true, WPA2PSKWPA3PSK = true,
}

local function apcli_ifaces()
	local out, seen = {}, {}
	local code, ls = sh("ls /sys/class/net 2>/dev/null")
	if code == 0 then
		for n in ls:gmatch("[%w_.%-]+") do
			if n:match("^apclix?%d+$") and not seen[n] then
				seen[n] = true
				out[#out + 1] = n
			end
		end
	end
	table.sort(out)
	return out
end

local function bh_status()
	local backhauls = {}
	for _, ifname in ipairs(apcli_ifaces()) do
		local e = { ifname = ifname, state = "down", ssid = "", bssid = "", rssi = "" }
		local flags = fs.access("/sys/class/net/" .. ifname .. "/flags")
			and read("/sys/class/net/" .. ifname .. "/flags") or nil
		local n = flags and tonumber(flags:gsub("%s+", ""), 16)
		if n then e.state = (n % 2 == 1) and "up" or "down" end
		local code, iw = sh("iwconfig " .. q(ifname) .. " 2>/dev/null")
		if code == 0 and iw then
			e.ssid = iw:match('ESSID:"(.-)"') or ""
			e.bssid = (iw:match("Access Point:%s*([%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x])") or ""):upper()
			e.rssi = iw:match("Signal level[=:]%s*(%-?%d+)") or ""
		end
		backhauls[#backhauls + 1] = e
	end
	return { ok = true, backhauls = backhauls }
end

local function bh_scan(args)
	args = args or {}
	local iface = v_apcli(args.iface)
	if not iface then return { ok = false, error = "Invalid interface name" } end
	if not fs.access("/sys/class/net/" .. iface) then
		return { ok = false, error = "接口不存在: " .. iface }
	end
	sh("iwpriv " .. q(iface) .. " set SiteSurvey=0")
	os.execute("sleep 4")
	local code, out = sh("iwpriv " .. q(iface) .. " get_site_survey 2>/dev/null")
	local cols, results = nil, {}
	for line in tostring(out or ""):gmatch("[^\r\n]+") do
		local has_mac = line:match("%s+%x%x:%x%x:%x%x:%x%x:%x%x:%x%x%s+")
		if #line > 40 and not has_mac then
			local c = {}
			local function col(pat)
				local s, e = line:find(pat)
				if s then c[#c + 1] = { s, e - s } end
			end
			col("Ch "); col("SSID"); col("BSSID"); col("Security")
			col("Sig%a%al"); col("W%-Mode"); col("ExtCH"); col("WPS")
			if #c >= 5 then cols = c end
		elseif cols and has_mac then
			local order = { "channel", "ssid", "bssid", "security", "rssi", "mode", "extch", "wps" }
			local entry = {}
			for i, def in ipairs(cols) do
				local name = order[i] or ("col" .. i)
				entry[name] = line:sub(def[1], def[1] + def[2]):gsub("^%s+", ""):gsub("%s+$", "")
			end
			if entry.bssid ~= "" and #entry.bssid >= 17 then
				entry.bssid = entry.bssid:sub(1, 17):upper()
				results[#results + 1] = entry
			end
		end
	end
	table.sort(results, function(a, b)
		return (tonumber(a.rssi) or -999) > (tonumber(b.rssi) or -999)
	end)
	-- guard against a stale "Disconnected" survey from a missing driver
	if code ~= 0 then
		return { ok = false, error = clean(out):gsub("%s+$", ""), exit_code = code }
	end
	return { ok = true, iface = iface, results = results }
end

local function bh_connect(args)
	args = args or {}
	local iface = v_apcli(args.iface)
	if not iface then return { ok = false, error = "Invalid interface name" } end
	local ssid = v_text(args.ssid)
	if not ssid then return { ok = false, error = "缺少回程 SSID" } end
	local auth = tostring(args.auth or "")
	if auth == "" then auth = kv_get("mapd_cfg", "BhProfile0AuthMode") or "WPA2PSK" end
	if not AUTH_MODES[auth] then return { ok = false, error = "Invalid authentication mode: " .. auth } end
	local enc = tostring(args.enc or "")
	local key = tostring(args.key or "")
	if auth ~= "OPEN" then
		if enc == "" then enc = "AES" end
		if key == "" then key = kv_get("mapd_cfg", "BhProfile0WpaPsk") or "" end
		if key == "" then return { ok = false, error = "加密模式需要回程密钥" } end
		if #key < 8 or #key > 63 then return { ok = false, error = "回程密钥需为 8-63 位" } end
		if not v_text(key) then return { ok = false, error = "回程密钥含非法字符" } end
		if not v_text(enc) then return { ok = false, error = "加密类型含非法字符" } end
	else
		enc, key = "", ""
	end
	local r1 = apply_kv("mapd_cfg", {
		BhProfile0Valid = "1",
		BhProfile0Ssid = ssid,
		BhProfile0AuthMode = auth,
		BhProfile0EncrypType = enc,
		BhProfile0WpaPsk = key,
	})
	if not r1.ok then return r1 end
	local r2 = apply_kv("1905d.cfg", { bh_type = "wifi" })
	if not r2.ok then return r2 end
	sh("ifconfig " .. q(iface) .. " up")
	sh("iwpriv " .. q(iface) .. " set ApCliEnable=0")
	sh("iwpriv " .. q(iface) .. " set ApCliAuthMode=" .. auth)
	if auth ~= "OPEN" then
		sh("iwpriv " .. q(iface) .. " set ApCliEncrypType=" .. q(enc))
		sh("iwpriv " .. q(iface) .. " set ApCliWPAPSK=" .. q(key))
	end
	sh("iwpriv " .. q(iface) .. " set ApCliSsid=" .. q(ssid))
	sh("iwpriv " .. q(iface) .. " set ApCliEnable=1")
	sh("iwpriv " .. q(iface) .. " set ApCliAutoConnect=3")
	return { ok = true, iface = iface, ssid = ssid, auth = auth, persisted = true }
end

