-- rpcd exec plugin contract (openwrt-24.10 rpcd plugin.c):
--   <script> list            -> print JSON method signatures
--   <script> call <method>   -> JSON args arrive on stdin; print one JSON object
-- manual testing: <script> <method> '<json>' (args via argv instead)
local function dispatch(m, a)
	if m == "status" then return status() end
	if m == "capabilities" then return capabilities() end
	if m == "config" then return { ok = true, config = config() } end
	if m == "topology" then return topology() end
	if m == "reload" then return reload() end
	if m == "set_field" then return set_field(a) end
	if m == "set_role" then return set_role(a) end
	if m == "set_backhaul" then return set_backhaul(a) end
	if m == "set_policy" then return set_policy(a) end
	return { ok = false, error = "unknown method" }
end
local cmd = arg[1]
if not cmd or cmd == "list" then
	io.write(json.encode(methods))
	io.write("\n")
else
	local m, argjson
	if cmd == "call" then
		m = arg[2]
		argjson = io.read("*a") or ""
		if argjson == "" then argjson = arg[3] end
	else
		m, argjson = cmd, arg[2]
	end
	local a = {}
	if argjson and argjson ~= "" then
		local ok, v = pcall(json.decode, argjson)
		if ok and type(v) == "table" then a = v end
	end
	local ok, res = pcall(dispatch, m, a)
	io.write(json.encode(ok and res or { ok = false, error = tostring(res) }))
	io.write("\n")
end
