#!/usr/bin/env lua
-- MTK MAP (EasyMesh) backend for luci-app-mtk-dash2
-- Writes only whitelisted keys in /etc/map/mapd_cfg and /etc/map/1905d.cfg.
-- wappctrl is used read-only (get map_devices / bh_link_list) for topology.
local json = require "luci.jsonc"
local fs = require "nixio.fs"

local MAP_DIR = "/etc/map"
local SERVICES = { "mapd", "wapp", "bs20" }
local BIN_DIRS = { "/usr/sbin", "/usr/bin", "/sbin", "/bin", "/usr/libexec" }
local SENSITIVE = { "key", "pass", "secret", "psk", "password", "cred", "alid" }
