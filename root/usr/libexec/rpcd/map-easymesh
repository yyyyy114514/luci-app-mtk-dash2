local function fields_meta()
	local meta = {}
	for _, id in ipairs(FIELD_IDS) do
		local f = FIELDS[id]
		if f then
			local m = { id = id, type = f.type, label = f.label, group = FIELD_GROUPS[id] or "其他" }
			if f.secret then m.secret = true end
			if f.type == "enum" then
				local opts, seen = {}, {}
				local function push(v, label)
					if not seen[v] then seen[v] = true; opts[#opts + 1] = { value = v, label = label } end
				end
				if f.labels then
					if f.enum_sort then
						for _, v in ipairs(f.enum_sort) do if f.labels[v] then push(v, f.labels[v]) end end
					end
					for _, v in pairs(f.map) do if f.labels[v] then push(v, f.labels[v]) end end
				else
					push("0", "停用")
					push("1", "启用")
				end
				m.options = opts
			end
			if f.type == "int" then m.min = f.min; m.max = f.max end
			if f.type == "string" or f.type == "mac" then m.len = 64 end
			meta[#meta + 1] = m
		end
	end
	return meta
end

local function capabilities()
	local writable = fs.access(MAP_DIR, "w")
	local writable_fields, missing = {}, {}
	for id, f in pairs(FIELDS) do
		local st = field_state(id)
		local w = writable and st and st.present
		if w then writable_fields[id] = true else missing[#missing + 1] = id end
	end
	local wc = bin("wappctrl")
	return {
		ok = true,
		wappctrl = wc ~= nil,
		config_present = fs.access(MAP_DIR .. "/mapd_cfg") ~= nil or fs.access(MAP_DIR .. "/1905d.cfg") ~= nil,
		writable = writable,
		writable_fields = writable_fields,
		missing_fields = missing,
		fields_meta = fields_meta(),
		groups = GROUP_ORDER,
		services = service_states(),
		note = "仅写入已探测到的白名单配置键（mapd_cfg / 1905d.cfg），写入前快照、失败自动回滚；拓扑查询只读使用 wappctrl get map_devices。",
	}
end

local function set_field(args)
	args = args or {}
	local id = args.field
	local f = id and FIELDS[id]
	if not f then return { ok = false, error = "未知字段: " .. tostring(id) } end
	local path = MAP_DIR .. "/" .. f.file
	local text = read(path)
	if not text then return { ok = false, error = "配置文件缺失: " .. path } end
	if text:find("\r") then return { ok = false, error = "配置文件含 CRLF 换行，拒绝改写" } end
	local cur_line
	for _, ln in ipairs(parse_file(text)) do
		if ln.kind == "kv" and ln.key:lower() == f.key:lower() then cur_line = ln break end
	end
	if not cur_line then return { ok = false, error = "配置中不存在键 " .. f.key .. "（固件版本可能不同）" } end
	local cur = stripq(cur_line.value)
	local nv
	if f.secret then
		local raw = args.value
		if type(raw) ~= "string" or raw == "" then
			return { ok = false, error = "未提供新密钥（留空表示不修改）" }
		end
		if raw == REDACTED or raw == "__unchanged__" then
			return { ok = false, error = "值未变化" }
		end
		if #raw < 8 or #raw > 63 then
			return { ok = false, error = "密钥需为 8-63 位" }
		end
		nv = raw
	elseif f.type == "enum" then
		local raw = args.value
		if type(raw) ~= "string" then return { ok = false, error = "缺少 value 参数" } end
		nv = f.map[raw] or f.map[raw:lower()]
		if not nv then
			local allowed = {}
			for k in pairs(f.map) do allowed[#allowed + 1] = k end
			table.sort(allowed)
			return { ok = false, error = "值不在白名单: " .. raw, allowed = allowed }
		end
	elseif f.type == "int" then
		local n = tonumber(args.value)
		if not n or n % 1 ~= 0 or n < f.min or n > f.max then
			return { ok = false, error = ("数值需为 %d-%d 之间的整数"):format(f.min, f.max) }
		end
		nv = tostring(n)
	elseif f.type == "string" then
		local raw = args.value
		if type(raw) ~= "string" then return { ok = false, error = "缺少 value 参数" } end
		raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if raw == "" or #raw > 64 then return { ok = false, error = "值需为 1-64 个字符" } end
		nv = raw
	elseif f.type == "mac" then
		local raw = args.value
		if type(raw) ~= "string" or not raw:match("^[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]$") then
			return { ok = false, error = "MAC 地址格式非法" }
		end
		nv = raw
	else
		return { ok = false, error = "不支持的字段类型" }
	end
	if not f.secret and cur == nv then return { ok = false, error = "值未变化（当前: " .. cur .. "）" } end
	-- keep original quoting style (mapd files are unquoted key=value)
	local openq, closeq = "", ""
	if cur_line.value:sub(1, 1) == '"' then openq, closeq = '"', '"' end
	if cur_line.value:sub(1, 1) == "'" then openq, closeq = "'", "'" end
	local snap = path .. ".mtk-rollback"
	local sf = io.open(snap, "wb")
	if not sf then return { ok = false, error = "无法创建回滚快照" } end
	sf:write(text)
	sf:close()
	local out_lines = {}
	for _, ln in ipairs(parse_file(text)) do
		if ln.kind == "kv" and ln.key:lower() == f.key:lower() then
			out_lines[#out_lines + 1] = ln.key .. "=" .. openq .. nv .. closeq
		else
			out_lines[#out_lines + 1] = ln.raw
		end
	end
	local content = table.concat(out_lines, "\n") .. "\n"
	local function rollback()
		local c = read(snap)
		if c then write_atomic(path, c) end
		os.remove(snap)
	end
	if not write_atomic(path, content) then
		rollback()
		return { ok = false, error = "配置写入失败，已回滚", rollback = true }
	end
	if (read(path) or "") ~= content then
		rollback()
		return { ok = false, error = "配置写入校验失败，已回滚", rollback = true }
	end
	if args.reload == true then
		local okr, results = reload_services()
		if not okr then
			rollback()
			return { ok = false, error = "服务重载失败，配置已回滚", rollback = true, results = results }
		end
		os.remove(snap)
		return { ok = true, field = id, key = f.key, old = f.secret and "***" or cur, value = nv, file = path, reloaded = true, results = results }
	end
	os.remove(snap)
	return { ok = true, field = id, key = f.key, old = f.secret and "***" or cur, value = nv, file = path }
end

