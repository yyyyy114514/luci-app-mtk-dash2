local function bin(name)
	for _, d in ipairs(BIN_DIRS) do
		local p = d .. "/" .. name
		if fs.access(p, "x") then return p end
	end
end

local function read(path)
	local f = io.open(path, "rb")
	if not f then return nil end
	local x = f:read("*a") or ""
	f:close()
	return x
end

local function q(s)
	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd)
	local tmp = os.tmpname()
	local ok, c = os.execute(cmd .. " > " .. q(tmp) .. " 2>&1")
	local out = ""
	local f = io.open(tmp, "rb")
	if f then out = f:read("*a") or ""; f:close() end
	os.remove(tmp)
	local code = 1
	if ok == true then code = 0
	elseif type(ok) == "number" then
		if ok == 0 then code = 0
		elseif ok % 256 == 0 then code = math.floor(ok / 256)
		else code = 128 + (ok % 256) end
	elseif type(c) == "number" then
		if c % 256 == 0 then code = math.floor(c / 256)
		else code = 128 + (c % 256) end
	end
	return code, out
end

local function clean(s)
	return tostring(s or ""):gsub(DIRTY, " "):sub(1, 4000)
end

local function sensitive(k)
	local lk = tostring(k or ""):lower()
	for _, w in ipairs(SENSITIVE) do
		if lk:find(w, 1, true) then return true end
	end
	return false
end

local function stripq(s)
	local a = s:match('^"(.*)"$')
	if not a then a = s:match("^'(.*)'$") end
	if not a then a = s end
	return a:gsub("%s+$", "")
end

local function write_atomic(path, content)
	local tmp = path .. ".mtk-tmp"
	local f = io.open(tmp, "wb")
	if not f then return false end
	f:write(content)
	f:close()
	local mode = fs.stat(path, "mode")
	if mode then pcall(fs.chmod, tmp, mode) end
	return os.rename(tmp, path)
end

local function parse_file(text)
	if type(text) ~= "string" then return {} end
	local out = {}
	for line in text:gmatch("[^\r\n]+") do
		local key, value = line:match("^%s*([%w_.-]+)%s*=%s*(.-)%s*$")
		if key then
			out[#out + 1] = { raw = line, key = key, value = value, kind = "kv" }
		else
			out[#out + 1] = { raw = line, kind = "other" }
		end
	end
	return out
end

local function file_text(name)
	local p = FILE_PATHS[name] or (MAP_DIR .. "/" .. name)
	local t = read(p)
	if not t then return nil end
	if t:find("\r") then return nil, "CRLF" end
	return t
end

local function kv_get(name, key)
	local t = file_text(name)
	if not t then return nil end
	for _, ln in ipairs(parse_file(t)) do
		if ln.kind == "kv" and ln.key:lower() == key:lower() then
			return stripq(ln.value)
		end
	end
end

local function first_wifi_iface()
	local nixio = require "nixio"
	for _, n in ipairs({ "ra0", "rai0", "rax0", "ra1" }) do
		if fs.access("/sys/class/net/" .. n) then return n end
	end
	return nil
end

-- read-only wappctrl query
local function wappctrl_get(param)
	local wc = bin("wappctrl")
	if not wc then return nil, "missing wappctrl" end
	local iface = first_wifi_iface()
	if not iface then return nil, "no wifi iface" end
	local code, out = sh(q(wc) .. " " .. q(iface) .. " get " .. q(param))
	if code ~= 0 then return nil, out end
	return out, nil
end

local function parse_topology(out)
	local nodes = {}
	if type(out) ~= "string" then return nodes end
	for line in out:gmatch("[^\r\n]+") do
		local mac = line:match("([%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x])")
		if mac then
			local role = line:match("[Rr]ole%s*[:=]%s*(%w+)") or "unknown"
			local existing = false
			for _, n in ipairs(nodes) do
				if n.mac == mac:lower() then existing = true break end
			end
			if not existing then
				nodes[#nodes + 1] = { mac = mac:lower(), role = role, raw = clean(line:sub(1, 200)) }
			end
		end
	end
	return nodes
end

local function topology()
	local out, err = wappctrl_get("map_devices")
	local nodes = {}
	if out then nodes = parse_topology(out) end
	local bh_out = wappctrl_get("bh_link_list")
	local links = {}
	if type(bh_out) == "string" then
		for line in bh_out:gmatch("[^\r\n]+") do
			if line:match("[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]") then
				links[#links + 1] = clean(line:sub(1, 200))
			end
		end
	end
	return {
		ok = true,
		available = out ~= nil,
		reason = out == nil and (err or "wappctrl 查询不可用") or nil,
		nodes = nodes,
		backhaul_links = links,
	}
end

local function config()
	local out = {}
	for _, name in ipairs({ "mapd_cfg", "1905d.cfg", "wapp_ap_ra0.conf" }) do
		local path = FILE_PATHS[name] or (MAP_DIR .. "/" .. name)
		local text = read(path)
		local e = { name = name, path = path, present = text ~= nil, fields = {} }
		for _, ln in ipairs(parse_file(text or "")) do
			if ln.kind == "kv" and not sensitive(ln.key) then
				e.fields[#e.fields + 1] = { key = ln.key, value = stripq(ln.value):sub(1, 160) }
			end
		end
		out[#out + 1] = e
	end
	return out
end

local function proc_running(name)
	local code = sh("pidof " .. name)
	if code == 0 then return true end
	local c2 = sh("pgrep -x " .. name)
	return c2 == 0
end

local function service_states()
	local states = {}
	for _, s in ipairs(SERVICES) do
		local initd = "/etc/init.d/" .. s
		if fs.access(initd, "x") then
			local code = sh(initd .. " running")
			states[s] = { status = code == 0 and "running" or "stopped", exit_code = code }
		elseif s == "mapd" then
			if fs.access(MAP_DIR .. "/mapd_cfg") then
				states[s] = { status = "config" }
			else
				states[s] = { status = "missing" }
			end
		else
			local exe = bin(s)
			if not exe then
				states[s] = { status = "missing" }
			else
				local enabled = true
				if s == "wapp" then
					local _, uout = sh("uci -q show wireless 2>/dev/null")
					enabled = tostring(uout or ""):match("%.wapp%s*=%s*['\"]?1") ~= nil
				end
				if proc_running(s) then
					states[s] = { status = "running", installed = true, exe = exe, enabled = enabled }
				else
					states[s] = { status = (not enabled) and "disabled" or "stopped", installed = true, exe = exe, enabled = enabled }
				end
			end
		end
	end
	return states
end

local ALID_FILE = "/etc/map/1905d.cfg"

local function restore_alid()
	local path = ALID_FILE
	if not fs.access(path) then return nil end
	local t = read(path)
	if not t then return nil end
	local saved = {}
	for _, ln in ipairs(parse_file(t)) do
		if ln.kind == "kv" and (ln.key:lower() == "map_controller_alid" or ln.key:lower() == "map_agent_alid") then
			saved[#saved + 1] = { key = ln.key, value = stripq(ln.value) }
		end
	end
	return saved
end

