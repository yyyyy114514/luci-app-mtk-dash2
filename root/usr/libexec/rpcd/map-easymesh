local function reload()
	local okr, results, warn = reload_services()
	return { ok = okr, results = results, warn = warn }
end

-- rpcd exec plugin contract requires every method signature value to be a
-- JSON object (blobmsg TABLE). luci.jsonc encodes empty Lua tables as [] (array),
-- which rpcd rpc_plugin_parse_signature() rejects, silently dropping the method
-- (observed as "RPC call to mtk-dash2/status failed: -32000 Object not found").
local function ensure_object(methods)
	local out = {}
	for k, v in pairs(methods) do
		if type(v) == "table" and next(v) == nil then
			out[k] = { __sig = true }
		else
			out[k] = v
		end
	end
	return out
end

