local ALLOWED = {}
for _, f in ipairs(DEVICE_FIELDS) do f.target = "device"; f.source = "wireless.device"; ALLOWED[f.id] = f end
for _, f in ipairs(IFACE_FIELDS) do f.target = "iface"; f.source = "wireless.iface"; ALLOWED[f.id] = f end

local function runtime_probes()
	local i = first_iface()
	local probes = {
		iface = i,
		mtwifi_cfg = { status = MTWIFI_CFG and "available" or "unavailable" },
		register = { status = "unavailable", reason = "missing iwpriv or iface" },
		spectrum = { status = "unavailable", reason = "no user-space spectrum tool" },
		temperature = { status = "unavailable", reason = "no confirmed entry" },
	}
	if i and IWPRIV then
		local c, o = sh(IWPRIV .. " " .. q(i))
		if c == 0 and #o > 0 then
			probes.register = { status = "available", command = "iwpriv " .. i .. " (列表)", output = o:sub(1, 400) }
			local ct, ot = sh(IWPRIV .. " " .. q(i) .. " get_temperature")
			if ct == 0 and ot:match("[%-]?%d+") then
				probes.temperature = { status = "available", command = "iwpriv " .. i .. " get_temperature", output = ot }
			end
		end
	end
	local sp = bin("spectrum")
	if sp then
		local c, o = sh(sp .. " --help")
		if c == 0 and o:lower():find("spectrum", 1, true) then
			probes.spectrum = { status = "available", command = sp .. " --help", output = o:sub(1, 400) }
		end
	end
	return probes
end

local function capabilities()
	local fields = {}
	for _, f in ipairs(DEVICE_FIELDS) do
		local x = {}; for k, v in pairs(f) do x[k] = v end; x.verified = true
		fields[#fields + 1] = x
	end
	for _, f in ipairs(IFACE_FIELDS) do
		local x = {}; for k, v in pairs(f) do x[k] = v end; x.verified = true
		fields[#fields + 1] = x
	end
	return {
		ok = true, fields = fields, probes = runtime_probes(),
		tools = { uci = UCI ~= nil, wifi = WIFI ~= nil, iwpriv = IWPRIV ~= nil, iwinfo = IWINFO ~= nil, mtwifi_cfg = MTWIFI_CFG ~= nil },
		writable = UCI ~= nil, apply = WIFI ~= nil,
	}
end

local function valid(f, v)
	if f.type == "boolean" then
		if type(v) == "boolean" then return v and "1" or "0" end
		if v == "1" or v == "0" or v == "true" or v == "false" then return (v == "1" or v == "true") and "1" or "0" end
		return nil
	end
	if f.type == "integer" then
		local n = tonumber(v)
		if not n or n % 1 ~= 0 then return nil end
		if f.min and n < f.min then return nil end
		if f.max and n > f.max then return nil end
		return tostring(n)
	end
	if type(v) ~= "string" then return nil end
	v = v:gsub("^%s+", ""):gsub("%s+$", "")
	if #v == 0 or #v > 64 or v:find("[%c%'%\"`$;|<>\\]") then return nil end
	if f.values then
		for _, x in ipairs(f.values) do if x == v then return v end end
		return nil
	end
	if f.id == "country" and not v:match("^%u%u$") then return nil end
	if f.id == "channel" and not (v == "auto" or v:match("^%d+$")) then return nil end
	if f.id == "maclist" or f.id == "steeringbssid" then
		local count = 0
		for mac in v:gmatch("[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]") do count = count + 1 end
		if count == 0 then return nil end
	end
	return v
end

local function apply(a)
	if not UCI then return { ok = false, error = "缺少 uci 命令", exit_code = 127 } end
	if type(a) ~= "table" or type(a.device) ~= "string" or not a.device:match("^radio%d+$") then return { ok = false, error = "device 参数非法" } end
	if type(a.values) ~= "table" or next(a.values) == nil then return { ok = false, error = "values 参数非法" } end
	local c, typ = sh(UCI .. " get wireless." .. q(a.device))
	if c ~= 0 or not typ:find("wifi-device", 1, true) then return { ok = false, error = "device 不存在或不是 wifi-device", exit_code = c } end
	local target = a.iface and iface_ok(a.iface)
	local has_iface_field = false
	for k in pairs(a.values) do
		if ALLOWED[k] and ALLOWED[k].target == "iface" then has_iface_field = true break end
	end
	if has_iface_field then
		if not target then return { ok = false, error = "iface 字段需要合法 iface 参数" } end
		local ci, ti = sh(UCI .. " get wireless." .. q(target))
		if ci ~= 0 or not ti:find("wifi-iface", 1, true) then
			return { ok = false, error = "iface 不存在或不是 wifi-iface", exit_code = ci }
		end
	end
	local before, changes = {}, {}
	for k, v in pairs(a.values) do
		local f = ALLOWED[k]
		local value = f and valid(f, v)
		if not value then return { ok = false, error = "参数或值非法: " .. tostring(k) } end
		if f.target == "iface" and not target then return { ok = false, error = "iface 字段需要合法 iface 参数" } end
		local section = f.target == "device" and a.device or target
		local path = "wireless." .. section .. "." .. f.uci
		local ec, old = sh(UCI .. " get " .. q(path))
		before[path] = { exists = ec == 0, value = old:gsub("%s+$", "") }
		ec = sh(UCI .. " set " .. q(path) .. "=" .. q(value))
		if ec ~= 0 then return { ok = false, error = "UCI 写入失败: " .. k, exit_code = ec } end
		changes[k] = value
	end
	c = sh(UCI .. " commit wireless")
	if c ~= 0 then return { ok = false, error = "UCI 提交失败", exit_code = c } end
	local steps = { { name = "uci commit", exit_code = c, ok = true } }
	local applied = false
	if a.apply == true then
		if not WIFI then
			return { ok = false, written = true, error = "缺少 wifi 命令，未应用", exit_code = 127 }
		end
		c = sh(WIFI .. " reload")
		applied = c == 0
		steps[#steps + 1] = { name = "wifi reload", exit_code = c, ok = applied }
	end
	if a.apply == true and not applied then
		for path, x in pairs(before) do
			if x.exists then sh(UCI .. " set " .. q(path) .. "=" .. q(x.value))
			else sh(UCI .. " delete " .. q(path)) end
		end
		sh(UCI .. " commit wireless")
		return { ok = false, applied = false, rolled_back = true, error = "无线配置应用失败，已回滚", exit_code = c, steps = steps }
	end
	if a.apply == true then
		local vc, vo = sh(UCI .. " changes wireless")
		steps[#steps + 1] = { name = "uci changes 复核", exit_code = vc, ok = vc == 0, output = vo:sub(1, 200) }
	end
	return { ok = true, device = a.device, iface = target, changed = changes, applied = applied, verified = true, exit_code = 0, steps = steps }
end

local function read_register(a)
	local i = iface_ok(a and a.iface)
	if not i or not IWPRIV then return { ok = false, error = "iface 参数非法或缺少 iwpriv", exit_code = 127 } end
	local c, o = sh(IWPRIV .. " " .. q(i) .. " show")
	if c ~= 0 and o:lower():find("usage", 1, true) then c = 0 end
	return { ok = c == 0, iface = i, output = o, read_only = true, exit_code = c }
end

local function parse_iwinfo(i)
	local c, o = sh(IWINFO .. " " .. q(i) .. " info")
	if c ~= 0 then return { ok = false, exit_code = c, error = "iwinfo 查询失败" } end
	return {
		ok = true, iface = i, tool = "iwinfo",
		channel = tonumber(o:match("Channel%s*:%s*(%d+)") or nil),
		tx_power = tonumber((o:match("Tx%-?Power%s*:%s*(%-?%d+)") or o:match("Tx Power%s*:%s*(%-?%d+)")) or nil),
		output = o,
	}
end

local function temperature(a)
	local i = iface_ok(a and a.iface) or first_iface()
	if not i or not IWPRIV then return { ok = false, error = "缺少可用接口或 iwpriv" } end
	local c, o = sh(IWPRIV .. " " .. q(i) .. " get_temperature")
	local v = o:match("[Tt]emperature[^%d%-]*([%-]?%d+%.?%d*)") or o:match("([%-]?%d+%.?%d*)")
	return { ok = c == 0 and v ~= nil, iface = i, value = v and tonumber(v), unit = "°C", exit_code = c, output = o }
end

local function channel(a)
	local i = iface_ok(a and a.iface) or first_iface()
	if not i or not IWINFO then return { ok = false, error = "缺少可用接口或 iwinfo" } end
	return parse_iwinfo(i)
end

local function power(a)
	local i = iface_ok(a and a.iface) or first_iface()
	if not i or not IWINFO then return { ok = false, error = "缺少可用接口或 iwinfo" } end
	return parse_iwinfo(i)
end

local function diagnostics()
	local steps, i = {}, first_iface()
	local function add(name, cmd, expect)
		local c, o = sh(cmd)
		steps[#steps + 1] = { name = name, command = cmd, exit_code = c, ok = c == (expect or 0), output = redact(o:sub(1, 2000)) }
	end
	if UCI then
		add("uci show wireless", UCI .. " show wireless")
		add("uci changes wireless", UCI .. " changes wireless")
	end
	if i then
		if IWPRIV then add("iwpriv 私有 ioctl 列表", IWPRIV .. " " .. q(i)) end
		if IWINFO then add("iwinfo " .. i .. " info", IWINFO .. " " .. q(i) .. " info") end
	end
	for _, svc in ipairs({ "wapp", "mapd", "1905d", "bs20" }) do
		local init = "/etc/init.d/" .. svc
		if fs.access(init, "x") then add("服务状态 " .. svc, init .. " status 2>/dev/null || true", 0) end
	end
	if MTWIFI_CFG then add("mtwifi_cfg 二进制探测", MTWIFI_CFG .. " 2>&1 || true", 0) end
	local mapcfg = {}
	for _, p in ipairs({ "/etc/map/mapd_cfg", "/etc/map/1905d.cfg" }) do
		local h = io.open(p, "r")
		if h then
			local t = h:read("*a") or ""; h:close()
			mapcfg[#mapcfg + 1] = { path = p, fields = #t, redacted = true }
			steps[#steps + 1] = { name = "MAP 配置 " .. p, exit_code = 0, ok = true, output = redact(t:sub(1, 1500)) }
		end
	end
	return { ok = true, redacted = true, iface = i, collected = os.date("%Y-%m-%dT%H:%M:%S"), steps = steps, map_files = mapcfg, probes = runtime_probes() }
end

local methods = {
	capabilities = {}, apply = { device = "", iface = "", values = {}, apply = false },
	read_register = { iface = "" }, diagnostics = {},
	temperature = { iface = "" }, channel = { iface = "" }, power = { iface = "" },
}
local function dispatch(m, a)
	if m == "capabilities" then return capabilities() end
	if m == "apply" then return apply(a) end
	if m == "read_register" then return read_register(a) end
	if m == "diagnostics" then return diagnostics() end
	if m == "temperature" then return temperature(a) end
	if m == "channel" then return channel(a) end
	if m == "power" then return power(a) end
	return { ok = false, error = "unknown method" }
end
-- rpcd exec plugin contract (openwrt-24.10 rpcd plugin.c):
--   <script> list            -> print JSON method signatures
--   <script> call <method>   -> JSON args arrive on stdin; print one JSON object
-- manual testing: <script> <method> '<json>' (args via argv instead)
local cmd = arg[1]
if not cmd or cmd == "list" then
	io.write(json.encode(methods) .. "\n")
else
	local m, argjson
	if cmd == "call" then
		m = arg[2]
		argjson = io.read("*a") or ""
		if argjson == "" then argjson = arg[3] end
	else
		m, argjson = cmd, arg[2]
	end
	local a = {}
	if argjson and argjson ~= "" then
		local ok, v = pcall(json.decode, argjson)
		if ok and type(v) == "table" then a = v end
	end
	local ok, r = pcall(dispatch, m, a)
	io.write(json.encode(ok and r or { ok = false, error = tostring(r) }) .. "\n")
end
