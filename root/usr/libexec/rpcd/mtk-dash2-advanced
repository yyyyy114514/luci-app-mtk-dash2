local fs = require "nixio.fs"

local function bin(names)
	if type(names) == "string" then names = { names } end
	for _, name in ipairs(names) do
		for _, d in ipairs({ "/usr/sbin", "/usr/bin", "/sbin", "/bin", "/usr/libexec" }) do
			local p = d .. "/" .. name
			if fs.access(p, "x") then return p end
		end
	end
end
local UCI = bin("uci")
local WIFI = bin("wifi")
local IWPRIV = bin("iwpriv")
local IWINFO = bin("iwinfo")
local MTWIFI_CFG = bin({ "mtwifi_cfg", "mtwifi-cfg" })

local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local function sh(c)
	local f = os.tmpname()
	local r = os.execute(c .. " >" .. q(f) .. " 2>&1")
	local h = io.open(f, "rb")
	local o = h and h:read("*a") or ""
	if h then h:close() end
	os.remove(f)
	local code = 1
	if r == true then code = 0
	elseif type(r) == "number" then
		if r == 0 then code = 0
		elseif r % 256 == 0 then code = math.floor(r / 256)
		else code = 128 + (r % 256)
		end
	end
	return code, o:gsub("[^%g%s]", " "):sub(1, 8000)
end

local function iface_ok(a)
	return type(a) == "string" and a:match("^[%w_.-]+$") and a or nil
end

local function safe_dir(path)
	local it = fs.dir(path)
	if not it then return function() return nil end end
	return it
end

local function first_iface()
	for n in safe_dir("/sys/class/net") do
		if n:match("^ra%d") or n:match("^rai%d") or n:match("^apcli") then return n end
	end
end

local REDACT_KEYS = { "[Kk][Ee][Yy]", "[Pp][Ss][Kk]", "[Pp][Aa][Ss][Ss]", "[Ss][Ee][Cc][Rr][Ee][Tt]", "[Cc][Rr][Ee][Dd]", "[Ww][Pp][Aa][Pp][Ss][Kk]", "[Ss][Aa][Ee]" }
local function redact(s)
	s = tostring(s or "")
	for _, w in ipairs(REDACT_KEYS) do
		s = s:gsub("([%w_.%-]*" .. w .. "[%w_.%-]*)=([^%s;]+)", "%1=***")
		s = s:gsub("([%w_.%-]*" .. w .. "[%w_.%-]*%s*[:=]%s*)('[^']*')", "%1'***'")
	end
	return s
end

