local function get_plugin_version()
	local f = io.open("/usr/share/luci-app-mtk-dash2/VERSION", "r")
	local v = f and f:read("*l") or nil
	if f then f:close() end
	return v and v:gsub("%s+$", "") or "0.2.0"
end
local PLUGIN_VERSION = get_plugin_version()
local STAMP_FILE = "/usr/share/luci-app-mtk-dash2/VERSION"
local REDACTED = "__mtk_redacted__"
local ARCHIVE_DIR = "/tmp/mtk-dash2/archives"
