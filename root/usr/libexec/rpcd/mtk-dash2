local function map_config_summary()
	local out = {}
	for _, name in ipairs(MAP_FILES) do
		local p = MAP_DIR .. "/" .. name
		local entry = { path = p, present = false, fields = {}, lines = 0 }
		local c = read_file(p)
		if c then
			entry.present = true
			entry.lines = select(2, c:gsub("\n", "\n"))
			for line in c:gmatch("[^\r\n]+") do
				local k, v = line:match("^%s*([%w_.-]+)%s*=%s*(.-)%s*$")
				if k and not is_sensitive(k) then
					entry.fields[#entry.fields + 1] = { key = k, value = v:sub(1, 120) }
				end
			end
		end
		out[#out + 1] = entry
	end
	return out
end

local function running_processes()
	local names = { "wapp", "bs20", "mapd", "1905" }
	local found, seen = {}, {}
	for pid in fs.dir("/proc") or {} do
		if pid:match("^%d+$") and not seen[pid] then
			local f = io.open("/proc/" .. pid .. "/comm", "r")
			if f then
				local name = f:read("*l")
				f:close()
				if name then
					for _, n in ipairs(names) do
						if name:find(n, 1, true) then
							seen[pid] = true
							found[#found + 1] = { pid = tonumber(pid), name = clean_text(name) }
							break
						end
					end
				end
			end
		end
	end
	table.sort(found, function(a, b) return a.pid < b.pid end)
	return found
end

local function probe_command(bin, args, matcher)
	if not bin then return { status = "unavailable", reason = "missing_or_probe_failed" } end
	local code, out = sh(bin .. " " .. args)
	out = clean_text(out)
	if code ~= 0 or (matcher and not matcher(out)) then
		return { status = "unavailable", exit_code = code, output = out:sub(1, 2000) }
	end
	return { status = "available", exit_code = code, output = out:sub(1, 2000) }
end

local function probe_first(specs)
	for _, s in ipairs(specs) do
		if s.bin then
			local p = probe_command(s.bin, s.args, s.match)
			if p.status == "available" then
				p.tool = s.tool
				p.command = s.bin .. " " .. s.args
				return p
			end
		end
	end
	return { status = "unavailable", reason = "missing_or_probe_failed" }
end

local function runtime_probes()
	local iface = wireless_iface_names()[1]
	local probes = {
		register = { status = "unavailable", reason = "missing_binary" },
		spectrum = { status = "unavailable", reason = "missing_binary" },
		wappctrl = { status = "unavailable", reason = "missing_binary" },
	}
	if IWPRIV_BIN and iface then
		probes.register = probe_first({
			{ bin = IWPRIV_BIN, args = q(iface) .. " --all", tool = "iwpriv", match = function(out)
				local low = out:lower()
				return low:find("register", 1, true) ~= nil or low:find("reg", 1, true) ~= nil
			end },
			{ bin = IWPRIV_BIN, args = q(iface) .. " help", tool = "iwpriv", match = function(out)
				local low = out:lower()
				return low:find("register", 1, true) ~= nil or low:find("reg_dump", 1, true) ~= nil
			end },
		})
	end
	local sp = find_bin("spectrum")
	if sp then
		probes.spectrum = probe_first({
			{ bin = sp, args = "--help", tool = "spectrum", match = function(out) return out:lower():find("spectrum", 1, true) ~= nil end },
			{ bin = sp, args = "-h", tool = "spectrum", match = function(out) return out:lower():find("spectrum", 1, true) ~= nil end },
		})
	elseif IWPRIV_BIN and iface then
		probes.spectrum = probe_first({
			{ bin = IWPRIV_BIN, args = q(iface) .. " --all", tool = "iwpriv", match = function(out)
				return out:lower():find("spectrum", 1, true) ~= nil
			end },
		})
	end
	local wc = find_bin("wappctrl")
	if wc then
		probes.wappctrl = probe_first({
			{ bin = wc, args = "-h", tool = "wappctrl", match = function(out) return out:lower():find("wapp", 1, true) ~= nil end },
			{ bin = wc, args = "--help", tool = "wappctrl", match = function(out) return out:lower():find("wapp", 1, true) ~= nil end },
		})
	end
	for _, s in ipairs(MAP_SERVICES) do
		local initd = "/etc/init.d/" .. s
		if fs.access(initd, "x") then
			local code, out = sh(initd .. " running")
			probes[s] = {
				status = code == 0 and "running" or "available",
				exit_code = code,
				command = initd .. " running",
				tool = "init.d",
				output = clean_text(out):sub(1, 400),
			}
		else
			probes[s] = { status = "unavailable", reason = "missing_service" }
		end
	end
	return probes
end

local function status()
	local w, err = ubus_call("status")
	if not w then return { ok = false, error = err or "ubus network.wireless 不可用" } end
	local radios, stations, station_count = {}, {}, 0
	for _, r in ipairs(extract_radios(w)) do
		local ri = {
			id = r.name or r.id,
			type = r.type,
			path = r.path,
			hwmode = r.hwmode,
			channel = r.channel,
			htmode = r.htmode,
			txpower = r.txpower,
			country = r.country,
			disabled = r.disabled == true,
			ifaces = {},
		}
		local ifs = r.ifaces or {}
		if type(ifs) == "table" then
			for _, f in ipairs(ifs) do
				if type(f) == "table" then
					local net = f.network
					if type(net) == "table" then net = table.concat(net, " ") end
					local fi = {
						ifname = f.ifname,
						ssid = clean_text(f.ssid or ""),
						mode = f.mode,
						network = net,
						encryption = f.encryption,
						macaddr = f.macaddr,
						disabled = f.disabled == true,
					}
					ri.ifaces[#ri.ifaces + 1] = fi
					if IWINFO_BIN and f.ifname and not f.disabled and (f.mode == "ap") then
						local c, o = sh(IWINFO_BIN .. " " .. q(f.ifname) .. " assoclist")
						if c == 0 then
							local list = parse_assoclist(o)
							stations[f.ifname] = list
							station_count = station_count + #list
						end
					end
				end
			end
		end
		radios[#radios + 1] = ri
	end
	return {
		ok = true,
		up = w.up == true,
		running = w.running == true,
		radios = radios,
		stations = stations,
		station_count = station_count,
		mtwifi = fs.access("/sys/module/mt_wifi"),
		wireless_ifaces = wireless_iface_names(),
	}
end

