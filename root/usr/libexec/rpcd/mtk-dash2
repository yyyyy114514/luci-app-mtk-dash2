local function find_keyword(keys, txt)
	if type(keys) ~= "table" or type(txt) ~= "string" then return false end
	for _, kw in ipairs(keys) do
		if txt:find(kw, 1, true) then return true end
	end
	return false
end

local function probe_advanced_fields()
	local wireless_txt = ""
	if UCI_BIN then
		local c, o = sh(UCI_BIN .. " show wireless")
		if c == 0 then wireless_txt = o or "" end
	end
	local dat_chunks = {}
	for n in fs.dir("/etc/wireless") or {} do
		local c = read_file("/etc/wireless/" .. n)
		if c then dat_chunks[#dat_chunks + 1] = c end
	end
	local dat_txt = table.concat(dat_chunks, "\n")
	local out = {}
	for _, f in ipairs(ADVANCED_FIELDS) do
		local spec = ADV_FIELD_PROBES[f.id]
		local verified = false
		if spec then
			if spec.multi_ssid then
				local n = 0
				for _ in wireless_txt:gmatch("option%s+ssid%s+") do n = n + 1 end
				verified = n >= 2
			else
				verified = find_keyword(spec.uci, wireless_txt)
					or find_keyword(spec.dat, dat_txt)
				if not verified and spec.module then
					for _, p in ipairs(spec.module) do
						if fs.access(p) then verified = true break end
					end
				end
			end
		end
		local copy = {
			id = f.id,
			label = f.label,
			category = f.category,
			type = f.type,
			verified = verified,
		}
		if f.values then copy.values = f.values end
		if f.min then copy.min = f.min end
		if f.max then copy.max = f.max end
		if f.default ~= nil then copy.default = f.default end
		if f.source then copy.source = f.source end
		if f.reload then copy.reload = f.reload end
		if f.note then copy.note = f.note end
		out[#out + 1] = copy
	end
	return out
end

local function capabilities()
	local map_present = fs.access(MAP_DIR .. "/1905d.cfg") or fs.access(MAP_DIR .. "/mapd_cfg")
	local comps = {}
	for _, n in ipairs(MAP_COMPONENTS) do
		local p = find_bin(n)
		comps[n] = p ~= nil
	end
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do
		svcs[n] = fs.access("/etc/init.d/" .. n, "x")
	end
	local has_svc = svcs.mapd or svcs.wapp or svcs.bs20
	local probes = runtime_probes()
	return {
		ok = true,
		version = plugin_version(),
		hardware = {
			mtwifi = fs.access("/sys/module/mt_wifi"),
			chipset = fs.access("/sys/module/mt_wifi") and "MT7981/MT7986" or nil,
			macaddr = read_file("/sys/class/net/wlan0/address"),
		},
		tools = {
			uci = UCI_BIN ~= nil,
			wifi = WIFI_BIN ~= nil,
			iwinfo = IWINFO_BIN ~= nil,
			tar = TAR_BIN ~= nil,
			sha256 = SHA_BIN ~= nil,
			logread = LOGREAD_BIN ~= nil,
			l1util = fs.access("/usr/sbin/l1util") or fs.access("/usr/bin/l1util"),
			mtwifi_cfg = fs.access("/usr/share/mtwifi-cfg") or fs.access("/usr/bin/mtwifi-cfg") or fs.access("/usr/sbin/mtwifi-cfg"),
		},
		map = {
			config = map_present,
			components = comps,
			services = svcs,
			has_managed_service = has_svc,
			wappctrl_probe = probes.wappctrl,
			probes = probes,
		},
		wireless_writable = fs.access("/etc/config/wireless", "w"),
		limits = { ap_max = 16, apcli_max = 1 },
		advanced_fields = probe_advanced_fields(),
		backend = "mtk-dash2",
	}
end

local function topology()
	local cfg = map_config_summary()
	local procs = running_processes()
	local w = ubus_call("status")
	local radios = {}
	if w then
		for _, r in ipairs(extract_radios(w)) do
			local ifs = {}
			for _, f in ipairs(r.ifaces or {}) do
				if type(f) == "table" then
					ifs[#ifs + 1] = { ifname = f.ifname, ssid = clean_text(f.ssid or ""), mode = f.mode, disabled = f.disabled == true }
				end
			end
			radios[#radios + 1] = { id = r.name or r.id, channel = r.channel, hwmode = r.hwmode, ifaces = ifs }
		end
	end
	local comps = {}
	for _, n in ipairs(MAP_COMPONENTS) do comps[n] = find_bin(n) ~= nil end
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do svcs[n] = fs.access("/etc/init.d/" .. n, "x") end
	local present = #cfg > 0 and cfg[1].present or false
	for _, e in ipairs(cfg) do if e.present then present = true end end
	local probes = runtime_probes()
	return {
		ok = true,
		available = present,
		components = comps,
		services = svcs,
		probes = probes,
		processes = procs,
		config = cfg,
		radios = radios,
		complete = false,
		hint = "MAP 闭源工具仅做固定查询与解析，拓扑可能不完整；运行时能力以 probes 状态为准",
	}
end

local function diagnostics()
	local steps = {}
	local function add(name, cmd, ok, extra)
		local s = { name = name, command = cmd, ok = ok == true, exit_code = 0 }
		for k, v in pairs(extra or {}) do s[k] = v end
		steps[#steps + 1] = s
	end

	local w, err = ubus_call("status")
	if w then
		add("无线状态", "ubus network.wireless status", true, { output = json.encode(redact_table(w)) })
	else
		add("无线状态", "ubus network.wireless status", false, { error = err or "调用失败" })
	end

	if UCI_BIN then
		local code, out = sh(UCI_BIN .. " show wireless")
		add("UCI 无线配置", UCI_BIN .. " show wireless", code == 0, { exit_code = code, output = redact_text(out) })
	else
		add("UCI 无线配置", "uci", false, { error = "缺少 uci 命令" })
	end

	local dat = {}
	for n in fs.dir("/etc/wireless") or {} do
		local p = "/etc/wireless/" .. n
		local st = fs.stat(p, "size") or 0
		dat[#dat + 1] = { name = n, bytes = st }
	end
	table.sort(dat, function(a, b) return a.name < b.name end)
	add("DAT 文件", "/etc/wireless", true, { files = dat })

	if LOGREAD_BIN then
		local code, out = sh(LOGREAD_BIN .. " -l 120")
		local filtered = {}
		for line in out:gmatch("[^\r\n]+") do
			if line:match("mt%-wifi") or line:match("wapp") or line:match("bs20") or line:match("1905") or line:match("mt7615") or line:match("ra0") or line:match("apcli") or line:match("mapd") then
				filtered[#filtered + 1] = clean_text(redact_line(line))
			end
		end
		add("系统日志(过滤)", LOGREAD_BIN .. " -l 120", code == 0, { exit_code = code, output = table.concat(filtered, "\n") })
	else
		add("系统日志", "logread", false, { error = "缺少 logread" })
	end

	local mapsum = map_config_summary()
	add("MAP 配置", "/etc/map/*", true, { files = mapsum })

	local ifaces = wireless_iface_names()
	add("无线接口", "/sys/class/net", true, { interfaces = ifaces })

	local probes = runtime_probes()
	add("运行时能力探测", "固定只读探测", true, { probes = probes })

	return { ok = true, redacted = true, collected = os.date("%Y-%m-%dT%H:%M:%S"), probes = probes, steps = steps }
end

local function set_radio(args)
	args = args or {}
	local device = args.device
	if type(device) ~= "string" or not device:match("^radio%d+$") then
		return { ok = false, error = "device 参数非法" }
	end
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令" } end
	local code, out = sh(UCI_BIN .. " get wireless." .. device)
	if code ~= 0 or not out:find("wifi%-device", 1, true) then
		return { ok = false, error = "device 不存在或不是 wifi-device" }
	end
	local disabled = args.enabled and "0" or "1"
	local c1 = sh(UCI_BIN .. " set wireless." .. device .. ".disabled=" .. disabled)
	local c2 = sh(UCI_BIN .. " commit wireless")
	local res = { ok = c1 == 0 and c2 == 0, device = device, disabled = disabled == "1", applied = false }
	if not res.ok then
		res.error = "uci 写入失败"
		return res
	end
	if args.apply then
		if not WIFI_BIN then
			res.error = "已写入 UCI，但缺少 wifi 命令，未应用"
			return res
		end
		local c3 = sh(WIFI_BIN .. " reload")
		res.applied = c3 == 0
		res.apply_exit_code = c3
	end
	return res
end

local function scan(args)
	args = args or {}
	local iface = args.iface
	if type(iface) ~= "string" or not iface:match("^[%w_.-]+$") then
		return { ok = false, error = "iface 参数非法" }
	end
	if not IWINFO_BIN then return { ok = false, error = "缺少 iwinfo" } end
	local code, out = sh(IWINFO_BIN .. " " .. q(iface) .. " scan")
	if code ~= 0 then
		return { ok = false, exit_code = code, iface = iface, output = clean_text(out), error = "扫描失败（接口可能未启用）" }
	end
	return { ok = true, iface = iface, cells = parse_scan(out) }
end

local function make_archive(dir, ts)
	local meta = {
		plugin = "luci-app-mtk-dash2",
		version = PLUGIN_VERSION,
		created = os.date("%Y-%m-%dT%H:%M:%S"),
		redacted = true,
		modules = {},
	}
	local c, rel = sh("cat /etc/openwrt_release 2>/dev/null | grep -E '^(DISTRIB_DESCRIPTION|DISTRIB_RELEASE)' | head -2")
	meta.firmware = c == 0 and clean_text(rel) or nil
	for _, m in ipairs(MODULES) do
		local content = read_file(m.src)
		if content then
			local red = redact_text(content)
			local dest = dir .. "/" .. m.arc
			local parent = dest:match("^(.*)/")
			if parent then fs.mkdir(parent) end
			fs.writefile(dest, red)
			meta.modules[#meta.modules + 1] = {
				id = m.id,
				label = m.label,
				source = m.src,
				arc = m.arc,
				redacted = true,
				bytes = #content,
			}
		end
	end
	fs.writefile(dir .. "/metadata.json", json.encode(meta))
	local arch = ARCHIVE_DIR .. "/" .. ts .. ".tar.gz"
	local code = sh(TAR_BIN .. " czf " .. q(arch) .. " -C " .. q(dir) .. " .")
	if code ~= 0 then
		rm_rf(dir)
		return nil, "tar 归档失败", code
	end
	rm_rf(dir)
	local size = fs.stat(arch, "size") or 0
	local sha = ""
	if SHA_BIN then
		local _, so = sh(SHA_BIN .. " " .. q(arch))
		sha = so:match("^([%x]+)") or ""
	end
	return {
		id = ts,
		file = arch,
		size = size,
		sha256 = sha,
		created = meta.created,
		redacted = true,
		modules = meta.modules,
	}, nil, 0
end

local function backup()
	if not TAR_BIN then return { ok = false, error = "缺少 tar，无法创建压缩归档" } end
	fs.mkdir(ARCHIVE_DIR)
	local ts = os.date("%Y%m%d-%H%M%S")
	local dir = ARCHIVE_DIR .. "/" .. ts .. ".d"
	fs.mkdir(dir)
	local manifest, err, code = make_archive(dir, ts)
	if not manifest then return { ok = false, error = err or "备份失败", exit_code = code } end
	return { ok = true, backup = manifest }
end

local function read_archive_meta(full)
	if not TAR_BIN then return nil end
	local code, out = sh(TAR_BIN .. " xzf " .. q(full) .. " -O ./metadata.json")
	if code ~= 0 then return nil end
	local ok, d = pcall(json.decode, out)
	if ok and type(d) == "table" then return d end
	return nil
end

local function list_backups()
	if not TAR_BIN then return { ok = false, error = "缺少 tar" } end
	local list = {}
	if fs.access(ARCHIVE_DIR) then
		for n in fs.dir(ARCHIVE_DIR) do
			local ts = n:match("^([%dTZ_:-]+)%.tar%.gz$")
			if ts then
				local full = ARCHIVE_DIR .. "/" .. n
				local meta = read_archive_meta(full) or {}
				list[#list + 1] = {
					id = ts,
					file = full,
					size = fs.stat(full, "size") or 0,
					created = meta.created or ts,
					redacted = meta.redacted ~= false,
					version = meta.version,
					firmware = meta.firmware,
					modules = meta.modules or {},
				}
			end
		end
	end
	table.sort(list, function(a, b) return a.id > b.id end)
	return { ok = true, backups = list }
end

local function validate_backup_id(id)
	if type(id) ~= "string" or not id:match("^[%dTZ_:-]+$") then return nil end
	local full = ARCHIVE_DIR .. "/" .. id .. ".tar.gz"
	if not fs.access(full) then return nil end
	return full
end

local function extract_archive(full)
	local tmp = os.tmpname()
	os.remove(tmp)
	fs.mkdir(tmp)
	local code = sh(TAR_BIN .. " xzf " .. q(full) .. " -C " .. q(tmp))
	if code ~= 0 then rm_rf(tmp); return nil, code end
	return tmp, 0
end

local function diff_files(arc_lines, cur_lines)
	local changes, samples = 0, {}
	local max_n = math.max(#arc_lines, #cur_lines)
	for i = 1, max_n do
		if arc_lines[i] ~= cur_lines[i] then
			changes = changes + 1
			if #samples < 8 then
				samples[#samples + 1] = {
					line = i,
					archived = arc_lines[i] or "",
					current = cur_lines[i] or "",
				}
			end
		end
	end
	return changes, samples
end

local function split_lines(text)
	local out = {}
	for line in text:gmatch("([^\r\n]*)\r?\n?") do
		if line ~= "" then out[#out + 1] = line end
	end
	return out
end

local function restore_preview(args)
	args = args or {}
	local full = validate_backup_id(args.backup)
	if not full then return { ok = false, error = "备份不存在或 ID 非法" } end
	local tmp, code = extract_archive(full)
	if not tmp then return { ok = false, error = "解压失败", exit_code = code } end
	local meta = read_archive_meta(full) or {}
	local files = {}
	for _, m in ipairs(meta.modules or {}) do
		local arc_file = tmp .. "/" .. (m.arc or m.id)
		local content = read_file(arc_file)
		local cur = read_file(m.source or "")
		local arc_lines = split_lines(content or "")
		local cur_lines = split_lines(cur or "")
		local changes, samples = diff_files(arc_lines, cur_lines)
		files[#files + 1] = {
			id = m.id,
			label = m.label,
			source = m.source,
			archived = content ~= nil,
			current_present = cur ~= nil,
			changes = changes,
			samples = samples,
		}
	end
	rm_rf(tmp)
	return {
		ok = true,
		backup = args.backup,
		created = meta.created,
		version = meta.version,
		firmware = meta.firmware,
		redacted = meta.redacted ~= false,
		modules = meta.modules or {},
		files = files,
	}
end

local function merge_restore(arc_content, cur_content)
	local arc_lines = split_lines(arc_content or "")
	local cur_lines = split_lines(cur_content or "")
	local out, skipped = {}, {}
	for i, al in ipairs(arc_lines) do
		if al:find(REDACTED, 1, true) then
			local cl = cur_lines[i]
			if cl and not cl:find(REDACTED, 1, true) and (cl:match("^%s*option%s+[%w_]+") or cl:match("^%s*[%w_.-]+%s*=")) then
				out[#out + 1] = cl
			else
				out[#out + 1] = al
				skipped[#skipped + 1] = {
					line = i,
					key = al:match("option%s+([%w_]+)") or al:match("^%s*([%w_.-]+)%s*=") or "?",
					reason = "当前配置无对应真实值，保留脱敏占位，需重新设置",
				}
			end
		else
			out[#out + 1] = al
		end
	end
	return table.concat(out, "\n") .. "\n", skipped
end

local function restore(args)
	args = args or {}
	local full = validate_backup_id(args.backup)
	if not full then return { ok = false, error = "备份不存在或 ID 非法" } end
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令" } end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "恢复前创建回滚点失败，已中止：" .. (rb.error or "") } end
	local tmp, code = extract_archive(full)
	if not tmp then return { ok = false, error = "解压失败", exit_code = code } end
	local restored, skipped_all = {}, {}
	for _, m in ipairs(MODULES) do
		local arc_file = tmp .. "/" .. m.arc
		local content = read_file(arc_file)
		if content then
			local cur = read_file(m.src) or ""
			local merged, skipped = merge_restore(content, cur)
			copy_file(m.src, m.src .. ".mtk-pre-restore")
			if write_atomic(m.src, merged) then
				restored[#restored + 1] = { id = m.id, path = m.src, bytes = #merged }
				for _, s in ipairs(skipped) do
					s.path = m.src
					skipped_all[#skipped_all + 1] = s
				end
			else
				restored[#restored + 1] = { id = m.id, path = m.src, error = "写入失败" }
			end
		end
	end
	rm_rf(tmp)
	local verify = sh(UCI_BIN .. " show wireless")
	if verify ~= 0 then
		for _, m in ipairs(MODULES) do
			if fs.access(m.src .. ".mtk-pre-restore") then
				copy_file(m.src .. ".mtk-pre-restore", m.src)
				os.remove(m.src .. ".mtk-pre-restore")
			end
		end
		return { ok = false, error = "恢复后 UCI 校验失败，已回滚所有文件", rollback_backup = rb.backup.id }
	end
	return {
		ok = true,
		restored = restored,
		skipped = skipped_all,
		rollback_backup = rb.backup.id,
		redacted_note = "归档已脱敏；恢复时敏感字段保留当前值，无法保留的字段已列入 skipped",
	}
end

local function apply_wireless()
	if not WIFI_BIN then return { ok = false, error = "缺少 wifi 命令" } end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "应用前创建备份失败，已中止：" .. (rb.error or "") } end
	local before = status()
	local code, out = sh(WIFI_BIN .. " reload")
	local after = status()
	return {
		ok = code == 0,
		exit_code = code,
		output = clean_text(out),
		rollback_backup = rb.backup.id,
		before = { up = before.up, running = before.running, station_count = before.station_count },
		after = { up = after.up, running = after.running, station_count = after.station_count },
	}
end

local function apply_map(args)
	args = args or {}
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do
		if fs.access("/etc/init.d/" .. n, "x") then svcs[#svcs + 1] = n end
	end
	if #svcs == 0 then
		return { ok = false, degraded = true, error = "未检测到可确认的 MAP 服务（mapd/wapp/bs20 均不存在），配置已落盘，重载需人工执行" }
	end
	if not args.restart then
		return { ok = false, need_restart = true, services = svcs, error = "需重启 MAP 服务以应用配置，请二次确认后传 restart=true" }
	end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "应用前创建备份失败，已中止：" .. (rb.error or "") } end
	local results = {}
	for _, s in ipairs(svcs) do
		local c, o = sh("/etc/init.d/" .. s .. " restart")
		results[#results + 1] = { service = s, exit_code = c, ok = c == 0, output = clean_text(o) }
	end
	local all_ok = true
	for _, r in ipairs(results) do if not r.ok then all_ok = false end end
	return { ok = all_ok, results = results, rollback_backup = rb.backup.id }
end

function list_methods()
	return {
		status = {},
		capabilities = {},
		topology = {},
		diagnostics = {},
		set_radio = { device = "", enabled = true, apply = false },
		scan = { iface = "" },
		apply_wireless = {},
		apply_map = { restart = false },
		backup = {},
		list_backups = {},
		restore_preview = { backup = "" },
		restore = { backup = "" },
	}
end

function call(method, args)
	if method == "status" then return status() end
	if method == "capabilities" then return capabilities() end
	if method == "topology" then return topology() end
	if method == "diagnostics" then return diagnostics() end
	if method == "set_radio" then return set_radio(args) end
	if method == "scan" then return scan(args) end
	if method == "apply_wireless" then return apply_wireless() end
	if method == "apply_map" then return apply_map(args) end
	if method == "backup" then return backup() end
	if method == "list_backups" then return list_backups() end
	if method == "restore_preview" then return restore_preview(args) end
	if method == "restore" then return restore(args) end
	return { ok = false, error = "unknown method" }
end

local method = arg[1]
if not method or method == "list" then
	io.write(json.encode(list_methods()))
	io.write("\n")
else
	local args = {}
	if arg[2] then
		local ok, d = pcall(json.decode, arg[2])
		if ok and type(d) == "table" then args = d end
	end
	local ok, res = pcall(call, method, args)
	if not ok then res = { ok = false, error = tostring(res) } end
	io.write(json.encode(res))
	io.write("\n")
end
