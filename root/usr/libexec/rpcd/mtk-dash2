local function set_radio(args)
	args = args or {}
	local device = args.device
	if type(device) ~= "string" or not device:match("^[%w_.-]+$") then
		return { ok = false, error = "device 参数非法" }
	end
	if type(args.enabled) ~= "boolean" then
		return { ok = false, error = "enabled 参数必须为布尔值" }
	end
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令", exit_code = 127 } end
	local c0, typ = sh(UCI_BIN .. " get wireless." .. device)
	if c0 ~= 0 or not typ:find("wifi-device", 1, true) then
		return { ok = false, error = "device 不存在或不是 wifi-device", exit_code = c0 }
	end
	local c1, prev = sh(UCI_BIN .. " get wireless." .. device .. ".disabled")
	if c1 ~= 0 then prev = "" end
	prev = prev:gsub("%s+$", "")
	local disabled = args.enabled and "0" or "1"
	local c2 = sh(UCI_BIN .. " set wireless." .. device .. ".disabled=" .. disabled)
	local c3 = sh(UCI_BIN .. " commit wireless")
	local res = { ok = c2 == 0 and c3 == 0, device = device, disabled = disabled == "1", applied = false }
	if not res.ok then
		res.error = "uci 写入失败"
		res.exit_code = c3 ~= 0 and c3 or c2
		return res
	end
	local vc, vv = sh(UCI_BIN .. " get wireless." .. device .. ".disabled")
	vv = vv:gsub("%s+$", "")
	res.verified = vc == 0 and vv == disabled
	if not res.verified then
		if prev ~= "" and prev ~= disabled then sh(UCI_BIN .. " set wireless." .. device .. ".disabled=" .. prev) end
		sh(UCI_BIN .. " commit wireless")
		res.error = "状态复核失败，已回滚"
		res.previous = prev
		return res
	end
	res.previous = prev
	if args.apply then
		if not WIFI_BIN then
			res.error = "已写入 UCI，但缺少 wifi 命令，未应用"
			return res
		end
		local c4 = sh(WIFI_BIN .. " reload")
		res.applied = c4 == 0
		res.apply_exit_code = c4
		if not res.applied then
			if prev ~= "" and prev ~= disabled then sh(UCI_BIN .. " set wireless." .. device .. ".disabled=" .. prev) end
			sh(UCI_BIN .. " commit wireless")
			res.error = "无线应用失败，已回滚"
			res.rolled_back = true
		end
	end
	return res
end

local function scan(args)
	args = args or {}
	local iface = args.iface
	if type(iface) ~= "string" or not iface:match("^[%w_.-]+$") then
		return { ok = false, error = "iface 参数非法" }
	end
	if not IWINFO_BIN then return { ok = false, error = "缺少 iwinfo" } end
	local code, out = sh(IWINFO_BIN .. " " .. q(iface) .. " scan")
	if code ~= 0 then
		return { ok = false, exit_code = code, iface = iface, output = clean_text(redact_text(out)), error = "扫描失败（接口可能未启用）" }
	end
	return { ok = true, iface = iface, cells = parse_scan(out) }
end

local function make_archive(dir, ts)
	local meta = {
		plugin = "luci-app-mtk-dash2",
		version = PLUGIN_VERSION,
		created = os.date("%Y-%m-%dT%H:%M:%S"),
		redacted = true,
		modules = {},
	}
	local c, rel = sh("cat /etc/openwrt_release 2>/dev/null | grep -E '^(DISTRIB_DESCRIPTION|DISTRIB_RELEASE)' | head -2")
	meta.firmware = c == 0 and clean_text(rel) or nil
	for _, m in ipairs(MODULES) do
		local content = read_file(m.src)
		if content then
			local red = redact_text(content)
			local dest = dir .. "/" .. m.arc
			local parent = dest:match("^(.*)/")
			if parent then fs.mkdir(parent) end
			fs.writefile(dest, red)
			meta.modules[#meta.modules + 1] = {
				id = m.id,
				label = m.label,
				source = m.src,
				arc = m.arc,
				redacted = true,
				bytes = #content,
			}
		end
	end
	fs.writefile(dir .. "/metadata.json", json.encode(meta))
	local arch = ARCHIVE_DIR .. "/" .. ts .. ".tar.gz"
	local code = sh(TAR_BIN .. " czf " .. q(arch) .. " -C " .. q(dir) .. " .")
	if code ~= 0 then
		rm_rf(dir)
		return nil, "tar 归档失败", code
	end
	rm_rf(dir)
	local size = fs.stat(arch, "size") or 0
	local sha = ""
	if SHA_BIN then
		local _, so = sh(SHA_BIN .. " " .. q(arch))
		sha = so:match("^([%x]+)") or ""
	end
	return {
		id = ts,
		file = arch,
		size = size,
		sha256 = sha,
		created = meta.created,
		redacted = true,
		modules = meta.modules,
	}, nil, 0
end

local function backup()
	if not TAR_BIN then return { ok = false, error = "缺少 tar，无法创建压缩归档" } end
	fs.mkdir(ARCHIVE_DIR)
	local ts = os.date("%Y%m%d-%H%M%S")
	local dir = ARCHIVE_DIR .. "/" .. ts .. ".d"
	fs.mkdir(dir)
	local manifest, err, code = make_archive(dir, ts)
	if not manifest then return { ok = false, error = err or "备份失败", exit_code = code } end
	return { ok = true, backup = manifest }
end

local function read_archive_meta(full)
	if not TAR_BIN then return nil end
	local code, out = sh(TAR_BIN .. " xzf " .. q(full) .. " -O ./metadata.json")
	if code ~= 0 then return nil end
	local ok, d = pcall(json.decode, out)
	if ok and type(d) == "table" then return d end
	return nil
end

local function list_backups()
	if not TAR_BIN then return { ok = false, error = "缺少 tar" } end
	local list = {}
	if fs.access(ARCHIVE_DIR) then
		for n in safe_dir(ARCHIVE_DIR) do
			local ts = n:match("^([%d%-]+)%.tar%.gz$")
			if ts then
				local full = ARCHIVE_DIR .. "/" .. n
				local meta = read_archive_meta(full) or {}
				list[#list + 1] = {
					id = ts,
					file = full,
					size = fs.stat(full, "size") or 0,
					created = meta.created or ts,
					redacted = meta.redacted ~= false,
					version = meta.version,
					firmware = meta.firmware,
					modules = meta.modules or {},
				}
			end
		end
	end
	table.sort(list, function(a, b) return a.id > b.id end)
	return { ok = true, backups = list }
end

local function validate_backup_id(id)
	if type(id) ~= "string" or not id:match("^[%d%-]+$") then return nil end
	local full = ARCHIVE_DIR .. "/" .. id .. ".tar.gz"
	if not fs.access(full) then return nil end
	return full
end

local function extract_archive(full)
	local tmp = os.tmpname()
	os.remove(tmp)
	fs.mkdir(tmp)
	local code = sh(TAR_BIN .. " xzf " .. q(full) .. " -C " .. q(tmp))
	if code ~= 0 then rm_rf(tmp); return nil, code end
	return tmp, 0
end

local function diff_files(arc_lines, cur_lines)
	local changes, samples = 0, {}
	local max_n = math.max(#arc_lines, #cur_lines)
	for i = 1, max_n do
		if arc_lines[i] ~= cur_lines[i] then
			changes = changes + 1
			if #samples < 8 then
				samples[#samples + 1] = {
					line = i,
					archived = arc_lines[i] or "",
					current = cur_lines[i] or "",
				}
			end
		end
	end
	return changes, samples
end

local function split_lines(text)
	local out = {}
	for line in text:gmatch("([^\r\n]*)\r?\n?") do
		if line ~= "" then out[#out + 1] = line end
	end
	return out
end

local function restore_preview(args)
	args = args or {}
	local full = validate_backup_id(args.backup)
	if not full then return { ok = false, error = "备份不存在或 ID 非法" } end
	local tmp, code = extract_archive(full)
	if not tmp then return { ok = false, error = "解压失败", exit_code = code } end
	local meta = read_archive_meta(full) or {}
	local files = {}
	for _, m in ipairs(meta.modules or {}) do
		local arc_file = tmp .. "/" .. (m.arc or m.id)
		local content = read_file(arc_file)
		local cur = read_file(m.source or "")
		local arc_lines = split_lines(content or "")
		local cur_lines = split_lines(cur or "")
		local changes, samples = diff_files(arc_lines, cur_lines)
		files[#files + 1] = {
			id = m.id,
			label = m.label,
			source = m.source,
			archived = content ~= nil,
			current_present = cur ~= nil,
			changes = changes,
			samples = samples,
		}
	end
	rm_rf(tmp)
	return {
		ok = true,
		backup = args.backup,
		created = meta.created,
		version = meta.version,
		firmware = meta.firmware,
		redacted = meta.redacted ~= false,
		modules = meta.modules or {},
		files = files,
	}
end

local function merge_restore(arc_content, cur_content)
	local arc_lines = split_lines(arc_content or "")
	local cur_lines = split_lines(cur_content or "")
	local cur_index = {}
	for i, cl in ipairs(cur_lines) do
		local key = cl:match("^%s*option%s+([%w_]+)") or cl:match("^%s*([%w_.-]+)%s*=")
		if key then
			if cur_index[key] == nil then cur_index[key] = {} end
			cur_index[key][#cur_index[key] + 1] = cl
		end
	end
	local out, skipped = {}, {}
	for _, al in ipairs(arc_lines) do
		if al:find(REDACTED, 1, true) then
			local key = al:match("option%s+([%w_]+)") or al:match("^%s*([%w_.-]+)%s*=")
			local pick = nil
			if key and cur_index[key] then
				for _, cl in ipairs(cur_index[key]) do
					if not cl:find(REDACTED, 1, true) then pick = cl break end
				end
			end
			if pick then
				out[#out + 1] = pick
			else
				out[#out + 1] = al
				skipped[#skipped + 1] = {
					line = key and key or al:sub(1, 40),
					key = key or "?",
					reason = "当前配置无对应真实值，保留脱敏占位，需重新设置",
				}
			end
		else
			out[#out + 1] = al
		end
	end
	return table.concat(out, "\n") .. "\n", skipped
end

local ROLLBACK_POINT = "/tmp/mtk-dash2/last-rollback-point"

local function save_rollback_point(id)
	fs.mkdir("/tmp/mtk-dash2")
	fs.writefile(ROLLBACK_POINT, tostring(id or ""))
end

local function read_rollback_point()
	local t = read_file(ROLLBACK_POINT)
	if t and t ~= "" then return t:gsub("%s+$", "") end
	return nil
end

local function restore(args)
	args = args or {}
	local full = validate_backup_id(args.backup)
	if not full then return { ok = false, error = "备份不存在或 ID 非法" } end
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令" } end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "恢复前创建回滚点失败，已中止：" .. (rb.error or "") } end
	save_rollback_point(rb.backup.id)
	local tmp, code = extract_archive(full)
	if not tmp then return { ok = false, error = "解压失败", exit_code = code } end
	local restored, skipped_all = {}, {}
	for _, m in ipairs(MODULES) do
		local arc_file = tmp .. "/" .. m.arc
		local content = read_file(arc_file)
		if content then
			local cur = read_file(m.src) or ""
			local merged, skipped = merge_restore(content, cur)
			copy_file(m.src, m.src .. ".mtk-pre-restore")
			if write_atomic(m.src, merged) then
				restored[#restored + 1] = { id = m.id, path = m.src, bytes = #merged }
				for _, s in ipairs(skipped) do
					s.path = m.src
					skipped_all[#skipped_all + 1] = s
				end
			else
				restored[#restored + 1] = { id = m.id, path = m.src, error = "写入失败" }
			end
		end
	end
	rm_rf(tmp)
	local v1 = sh(UCI_BIN .. " show wireless")
	local v2 = sh(UCI_BIN .. " changes wireless")
	if v1 ~= 0 or v2 ~= 0 then
		for _, m in ipairs(MODULES) do
			if fs.access(m.src .. ".mtk-pre-restore") then
				copy_file(m.src .. ".mtk-pre-restore", m.src)
				os.remove(m.src .. ".mtk-pre-restore")
			end
		end
		return { ok = false, error = "恢复后 UCI 校验失败，已回滚所有文件", exit_code = v1 ~= 0 and v1 or v2, rollback_backup = rb.backup.id }
	end
	local res = {
		ok = true,
		restored = restored,
		skipped = skipped_all,
		rollback_backup = rb.backup.id,
		redacted_note = "归档已脱敏；恢复时敏感字段保留当前值，无法保留的字段已列入 skipped",
	}
	local rc, rout
	if WIFI_BIN then
		rc, rout = sh(WIFI_BIN .. " reload")
		res.apply_exit_code = rc
		res.applied = rc == 0
		if rc == 0 then
			local after = status()
			res.verified = after and after.up ~= false
		end
		if rc ~= 0 or res.verified == false then
			for _, m in ipairs(MODULES) do
				if fs.access(m.src .. ".mtk-pre-restore") then
					copy_file(m.src .. ".mtk-pre-restore", m.src)
					os.remove(m.src .. ".mtk-pre-restore")
				end
			end
			sh(WIFI_BIN .. " reload")
			res.ok = false
			res.rolled_back = true
			res.error = "恢复后无线应用或状态复核失败，已回滚恢复前文件"
		end
	else
		res.applied = false
		res.error = "文件已恢复，但缺少 wifi 命令，未应用"
	end
	for _, m in ipairs(MODULES) do
		if fs.access(m.src .. ".mtk-pre-restore") then os.remove(m.src .. ".mtk-pre-restore") end
	end
	return res
end

local function apply_wireless()
	if not WIFI_BIN then return { ok = false, error = "缺少 wifi 命令", exit_code = 127 } end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "应用前创建备份失败，已中止：" .. (rb.error or "") } end
	save_rollback_point(rb.backup.id)
	local before = status()
	local code, out = sh(WIFI_BIN .. " reload")
	local after = status()
	local healthy = after and after.up ~= false and #(after.radios or {}) >= #(before.radios or {})
	local res = {
		ok = code == 0 and healthy,
		exit_code = code,
		output = clean_text(out),
		rollback_backup = rb.backup.id,
		verified = healthy,
		before = { up = before.up, running = before.running, station_count = before.station_count },
		after = { up = after.up, running = after.running, station_count = after.station_count },
	}
	if not healthy then
		res.error = "应用后无线状态复核异常"
	end
	return res
end

local function apply_map(args)
	args = args or {}
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do
		if fs.access("/etc/init.d/" .. n, "x") then svcs[#svcs + 1] = n end
	end
	if #svcs == 0 then
		return { ok = false, degraded = true, error = "未检测到可确认的 MAP 服务（mapd/wapp/bs20 均不存在），配置已落盘，重载需人工执行" }
	end
	if not args.restart then
		return { ok = false, need_restart = true, services = svcs, error = "需重启 MAP 服务以应用配置，请二次确认后传 restart=true" }
	end
	local rb = backup()
	if not rb.ok then return { ok = false, error = "应用前创建备份失败，已中止：" .. (rb.error or "") } end
	local results = {}
	for _, s in ipairs(svcs) do
		local c, o = sh("/etc/init.d/" .. s .. " restart")
		results[#results + 1] = { service = s, exit_code = c, ok = c == 0, output = clean_text(o) }
	end
	local all_ok = true
	for _, r in ipairs(results) do if not r.ok then all_ok = false end end
	return { ok = all_ok, results = results, rollback_backup = rb.backup.id }
end

local function rollback(args)
	args = args or {}
	local id = args.backup or read_rollback_point()
	if not id or id == "" then return { ok = false, error = "没有可用的回滚点（此前的恢复/应用未创建，或设备已重启清除 /tmp）" } end
	local res = restore({ backup = id })
	res.requested = args.backup and "manual" or "auto"
	return res
end

-- rpcd exec plugin contract requires every method signature value to be a
-- JSON object (blobmsg TABLE). luci.jsonc encodes empty Lua tables as [] (array),
-- which rpcd rpc_plugin_parse_signature() rejects, silently dropping the method
-- (observed as "RPC call to mtk-dash2/status failed: -32000 Object not found").
local function ensure_object(methods)
	local out = {}
	for k, v in pairs(methods) do
		if type(v) == "table" and next(v) == nil then
			out[k] = { __sig = true }
		else
			out[k] = v
		end
	end
	return out
end

function list_methods()
	return {
		status = {},
		capabilities = {},
		topology = {},
		diagnostics = {},
		get_wireless_config = {},
		set_radio = { device = "", enabled = true, apply = false },
		update_device = { device = "", values = {}, apply = false },
		update_vif = { iface = "", values = {}, apply = false },
		add_vif = { device = "", mode = "", ssid = "", encryption = "", key = "", network = "", bssid = "", apply = false },
		delete_vif = { iface = "", apply = false },
		scan = { iface = "" },
		apply_wireless = {},
		apply_map = { restart = false },
		backup = {},
		list_backups = {},
		restore_preview = { backup = "" },
		restore = { backup = "" },
		rollback = { backup = "" },
	}
end

function call(method, args)
	if method == "status" then return status() end
	if method == "capabilities" then return capabilities() end
	if method == "topology" then return topology() end
	if method == "diagnostics" then return diagnostics() end
	if method == "get_wireless_config" then return get_wireless_config() end
	if method == "set_radio" then return set_radio(args) end
	if method == "update_device" then return update_device(args) end
	if method == "update_vif" then return update_vif(args) end
	if method == "add_vif" then return add_vif(args) end
	if method == "delete_vif" then return delete_vif(args) end
	if method == "scan" then return scan(args) end
	if method == "apply_wireless" then return apply_wireless() end
	if method == "apply_map" then return apply_map(args) end
	if method == "backup" then return backup() end
	if method == "list_backups" then return list_backups() end
	if method == "restore_preview" then return restore_preview(args) end
	if method == "restore" then return restore(args) end
	if method == "rollback" then return rollback(args) end
	return { ok = false, error = "unknown method" }
end

-- rpcd exec plugin contract (openwrt-24.10 rpcd plugin.c):
--   <script> list            -> print JSON method signatures
--   <script> call <method>   -> JSON args arrive on stdin; print one JSON object
-- manual testing: <script> <method> '<json>' (args via argv instead)
local cmd = arg[1]
if not cmd or cmd == "list" then
	io.write(json.encode(ensure_object(list_methods())))
	io.write("\n")
else
	local method, argjson
	if cmd == "call" then
		method = arg[2]
		argjson = io.read("*a") or ""
		if argjson == "" then argjson = arg[3] end
	else
		method, argjson = cmd, arg[2]
	end
	local args = {}
	if argjson and argjson ~= "" then
		local ok, d = pcall(json.decode, argjson)
		if ok and type(d) == "table" then args = d end
	end
	local ok, res = pcall(call, method, args)
	if not ok then res = { ok = false, error = tostring(res) } end
	io.write(json.encode(res))
	io.write("\n")
end
