local fs = require "nixio.fs"

local function get_plugin_version()
	local f = io.open("/usr/share/luci-app-mtk-dash2/VERSION", "r")
	local v = f and f:read("*l") or nil
	if f then f:close() end
	return v and v:gsub("%s+$", "") or "0.2.0"
end
local PLUGIN_VERSION = get_plugin_version()
local STAMP_FILE = "/usr/share/luci-app-mtk-dash2/VERSION"
local REDACTED = "__mtk_redacted__"
local ARCHIVE_DIR = "/tmp/mtk-dash2/archives"
local MAP_DIR = "/etc/map"

local SENSITIVE_WORDS = {
	"key", "psk", "pass", "secret", "password", "sae", "wep", "pin",
	"preSharedKey", "pre_shared_key", "wpapsk", "wpa_key", "repeater",
	"k1", "k2", "pmk", "dpp", "bootstrap", "authpass", "cred",
}

local function is_sensitive(key)
	local k = tostring(key or ""):lower()
	for _, w in ipairs(SENSITIVE_WORDS) do
		if k:find(w, 1, true) then return true end
	end
	return false
end

local function clean_text(s)
	if type(s) ~= "string" then return "" end
	s = s:gsub("\0", " ")
	s = s:gsub("[\1-\8\11\12\14-\31\127]", " ")
	local t, i, n = {}, 1, #s
	while i <= n do
		local b = s:byte(i)
		if b < 128 then
			t[#t + 1] = string.char(b)
			i = i + 1
		elseif b >= 192 and b <= 244 then
			local nb = 1
			if b >= 240 then nb = 3
			elseif b >= 224 then nb = 2
			end
			if i + nb <= n then
				local okc = true
				for j = i + 1, i + nb do
					local c = s:byte(j)
					if not (c >= 128 and c <= 191) then okc = false break end
				end
				if okc then
					t[#t + 1] = s:sub(i, i + nb)
					i = i + nb + 1
				else
					i = i + 1
				end
			else
				i = i + 1
			end
		else
			i = i + 1
		end
	end
	s = table.concat(t)
	if #s > 20000 then s = s:sub(1, 20000) end
	return s
end

local function redact_line(line)
	line = line:gsub("(option%s+([%w_]+)%s*['\"])([^'\"]*)(['\"])", function(pre, k, v, post)
		if is_sensitive(k) then return pre .. REDACTED .. post end
		return pre .. v .. post
	end)
	line = line:gsub("(^|[^%w_])([%w_.-]+)=(['\"]?)([^%s'\"]*)(['\"]?)", function(prefix, k, q1, v, q2)
		if is_sensitive(k) then return prefix .. k .. "=" .. q1 .. REDACTED .. q2 end
		return prefix .. k .. "=" .. q1 .. v .. q2
	end)
	return line
end

local function redact_text(text)
	if type(text) ~= "string" then return "" end
	local out = {}
	for line in text:gmatch("[^\r\n]*") do
		out[#out + 1] = redact_line(line)
	end
	return table.concat(out, "\n")
end

local function redact_table(t)
	if type(t) ~= "table" then return t end
	local r = {}
	for k, v in pairs(t) do
		if type(k) == "string" and is_sensitive(k) then
			r[k] = "***"
		elseif type(v) == "table" then
			r[k] = redact_table(v)
		else
			r[k] = v
		end
	end
	return r
end

local BIN_DIRS = { "/usr/sbin", "/usr/bin", "/sbin", "/bin", "/usr/libexec", "/usr/share" }
local function find_bin(name)
	for _, d in ipairs(BIN_DIRS) do
		local p = d .. "/" .. name
		if fs.access(p, "x") then return p end
	end
	return nil
end

local function safe_dir(path)
	local it = fs.dir(path)
	if not it then return function() return nil end end
	return it
end

local UCI_BIN = find_bin("uci")
local WIFI_BIN = find_bin("wifi")
local IWINFO_BIN = find_bin("iwinfo")
local TAR_BIN = find_bin("tar")
local SHA_BIN = find_bin("sha256sum")
local LOGREAD_BIN = find_bin("logread")
local IWPRIV_BIN = find_bin("iwpriv")
local MTWIFI_CFG_BIN = find_bin("mtwifi_cfg")

local function q(s)
	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function sh(cmd)
	local tmp = os.tmpname()
	local r = os.execute(cmd .. " >" .. q(tmp) .. " 2>&1")
	local out = ""
	local f = io.open(tmp, "rb")
	if f then out = f:read("*a") or ""; f:close() end
	os.remove(tmp)
	if r == true then return 0, out end
	if type(r) == "number" then
		if r == 0 then return 0, out end
		if r % 256 == 0 then return math.floor(r / 256), out end
		return 128 + (r % 256), out
	end
	return 1, out
end

local function rm_rf(p)
	local function rec(x)
		if fs.stat(x, "type") ~= "dir" then return end
		for n in safe_dir(x) do
			if n ~= "." and n ~= ".." then
				local c = x .. "/" .. n
				if fs.stat(c, "type") == "dir" then rec(c) else os.remove(c) end
			end
		end
		fs.rmdir(x)
	end
	pcall(rec, p)
end

local function read_file(p)
	local f = io.open(p, "rb")
	if not f then return nil end
	local c = f:read("*a")
	f:close()
	return c
end

local function plugin_version()
	local v = read_file(STAMP_FILE)
	if v then v = v:match("^%s*([%w.%-]+)") end
	if v and v ~= "" then return v end
	return PLUGIN_VERSION
end

local function write_atomic(path, content)
	local tmp = path .. ".mtk-tmp"
	local f = io.open(tmp, "wb")
	if not f then return false end
	f:write(content)
	f:close()
	local mode = fs.stat(path, "mode")
	if mode then pcall(fs.chmod, tmp, mode) end
	return os.rename(tmp, path)
end

local function copy_file(src, dst)
	local c = read_file(src)
	if not c then return false end
	return write_atomic(dst, c)
end

local function ubus_call(method, args)
	local ok, u = pcall(function() return require("ubus").connect() end)
	if not ok or not u then return nil, "ubus unavailable" end
	local result = u:call("network.wireless", method, args or {})
	u:close()
	return result
end

local function ubus_object_call(object, method, args)
	local ok, u = pcall(function() return require("ubus").connect() end)
	if not ok or not u then return nil, "ubus unavailable" end
	local okc, result = pcall(function() return u:call(object, method, args or {}) end)
	u:close()
	if not okc then return nil, result end
	return result
end

local function uci_get_wireless_values()
	local r = ubus_object_call("uci", "get", { config = "wireless" })
	if type(r) == "table" and type(r.values) == "table" then return r.values end
	return nil
end

local function wireless_iface_names()
	local out = {}
	for n in safe_dir("/sys/class/net") do
		if n:match("^ra%d") or n:match("^rai%d") or n:match("^apcli") then
			out[#out + 1] = n
		end
	end
	table.sort(out)
	return out
end

local function extract_radios(w)
	if not w then return {} end
	if type(w.radios) == "table" then
		local out = {}
		for _, r in ipairs(w.radios) do
			if type(r) == "table" then out[#out + 1] = r end
		end
		return out
	end
	local out = {}
	for _, r in pairs(w) do
		if type(r) == "table" and (r.ifaces or r.disabled ~= nil or r.type or r.name) then
			out[#out + 1] = r
		end
	end
	return out
end

local function parse_assoclist(out)
	local list, cur = {}, nil
	for line in out:gmatch("[^\r\n]+") do
		local mac = line:match("^%s*Station%s+([%x:]+)")
		if mac then
			cur = { mac = mac }
			list[#list + 1] = cur
		elseif cur then
			local sig = line:match("signal:%s*(-?%d+)")
			local rate = line:match("tx bitrate:%s*([%d.]+)")
			local rxrate = line:match("rx bitrate:%s*([%d.]+)")
			local idle = line:match("inactive time:%s*(%d+)")
			if sig then cur.signal = tonumber(sig) end
			if rate then cur.tx_rate = tonumber(rate) end
			if rxrate then cur.rx_rate = tonumber(rxrate) end
			if idle then cur.inactive = tonumber(idle) end
		end
	end
	return list
end

local function parse_scan(out)
	local cells, cur = {}, nil
	for line in out:gmatch("[^\r\n]+") do
		local addr = line:match("Cell%s+%d+%s+-%s+Address:%s*([%x:]+)")
		if addr then
			cur = { address = addr }
			cells[#cells + 1] = cur
		elseif cur then
			local essid = line:match('ESSID:%s*"([^"]*)"')
			local mode = line:match("Mode:%s*([%w]+)")
			local chan = line:match("Channel:%s*(%d+)")
			local sig = line:match("Signal:%s*(-?%d+)")
			local enc = line:match("Encryption:%s*([^%s][^\r\n]*)")
			local ht = line:match("HT Mode:%s*([%w]+)")
			local bssid = line:match("BSSID:%s*([%x:]+)")
			local freq = line:match("Frequency:%s*([%d%.]+)")
			if essid then cur.essid = clean_text(essid) end
			if mode then cur.mode = mode end
			if chan then cur.channel = tonumber(chan) end
			if sig then cur.signal = tonumber(sig) end
			if enc then cur.encryption = clean_text(enc) end
			if ht then cur.ht_mode = ht end
			if bssid then cur.bssid = bssid end
			if freq then cur.frequency = tonumber(freq) end
		end
	end
	return cells
end

local MAP_COMPONENTS = { "wappctrl", "wapp", "bs20" }
local MAP_FILES = { "1905d.cfg", "mapd_cfg" }
local MAP_SERVICES = { "mapd", "wapp", "bs20" }

local MODULES = {
	{ id = "wireless", label = "Wireless UCI", src = "/etc/config/wireless", arc = "wireless.conf" },
	{ id = "map_1905d", label = "MAP 1905d.cfg", src = MAP_DIR .. "/1905d.cfg", arc = "map/1905d.cfg" },
	{ id = "map_mapd", label = "MAP mapd_cfg", src = MAP_DIR .. "/mapd_cfg", arc = "map/mapd_cfg" },
	{ id = "wapp_uci", label = "WAPP UCI", src = "/etc/config/wapp", arc = "etc-config-wapp" },
	{ id = "mapd_uci", label = "MAPD UCI", src = "/etc/config/mapd", arc = "etc-config-mapd" },
}

local function map_config_summary()
	local out = {}
	for _, name in ipairs(MAP_FILES) do
		local p = MAP_DIR .. "/" .. name
		local entry = { path = p, present = false, fields = {}, lines = 0 }
		local c = read_file(p)
		if c then
			entry.present = true
			entry.lines = select(2, c:gsub("\n", "\n"))
			for line in c:gmatch("[^\r\n]+") do
				local k, v = line:match("^%s*([%w_.-]+)%s*=%s*(.-)%s*$")
				if k and not is_sensitive(k) then
					entry.fields[#entry.fields + 1] = { key = k, value = v:sub(1, 120) }
				end
			end
		end
		out[#out + 1] = entry
	end
	return out
end

local function running_processes()
	local names = { "wapp", "bs20", "mapd", "1905" }
	local found, seen = {}, {}
	for pid in safe_dir("/proc") do
		if pid:match("^%d+$") and not seen[pid] then
			local f = io.open("/proc/" .. pid .. "/comm", "r")
			if f then
				local name = f:read("*l")
				f:close()
				if name then
					for _, n in ipairs(names) do
						if name:find(n, 1, true) then
							seen[pid] = true
							found[#found + 1] = { pid = tonumber(pid), name = clean_text(name) }
							break
						end
					end
				end
			end
		end
	end
	table.sort(found, function(a, b) return a.pid < b.pid end)
	return found
end

local function probe_command(bin, args, matcher)
	if not bin then return { status = "unavailable", reason = "missing_or_probe_failed" } end
	local code, out = sh(bin .. " " .. args)
	out = clean_text(out)
	if code ~= 0 or (matcher and not matcher(out)) then
		return { status = "unavailable", exit_code = code, output = out:sub(1, 2000) }
	end
	return { status = "available", exit_code = code, output = out:sub(1, 2000) }
end

local function probe_first(specs)
	for _, s in ipairs(specs) do
		if s.bin then
			local p = probe_command(s.bin, s.args, s.match)
			if p.status == "available" then
				p.tool = s.tool
				p.command = s.bin .. " " .. s.args
				return p
			end
		end
	end
	return { status = "unavailable", reason = "missing_or_probe_failed" }
end

local function runtime_probes()
	local iface = wireless_iface_names()[1]
	local probes = {
		register = { status = "unavailable", reason = "missing_binary" },
		spectrum = { status = "unavailable", reason = "missing_binary" },
		wappctrl = { status = "unavailable", reason = "missing_binary" },
		mtwifi_cfg = { status = "unavailable", reason = "missing_binary" },
		temperature = { status = "unavailable", reason = "missing_binary" },
		channel = { status = "unavailable", reason = "missing_binary" },
		power = { status = "unavailable", reason = "missing_binary" },
	}
	if IWPRIV_BIN and iface then
		probes.register = probe_first({
			{ bin = IWPRIV_BIN, args = q(iface) .. " --all", tool = "iwpriv", match = function(out)
				local low = out:lower()
				return low:find("register", 1, true) ~= nil or low:find("reg", 1, true) ~= nil
			end },
			{ bin = IWPRIV_BIN, args = q(iface) .. " help", tool = "iwpriv", match = function(out)
				local low = out:lower()
				return low:find("register", 1, true) ~= nil or low:find("reg_dump", 1, true) ~= nil
			end },
		})
	end
	local sp = find_bin("spectrum")
	if sp then
		probes.spectrum = probe_first({
			{ bin = sp, args = "--help", tool = "spectrum", match = function(out) return out:lower():find("spectrum", 1, true) ~= nil end },
			{ bin = sp, args = "-h", tool = "spectrum", match = function(out) return out:lower():find("spectrum", 1, true) ~= nil end },
		})
	elseif IWPRIV_BIN and iface then
		probes.spectrum = probe_first({
			{ bin = IWPRIV_BIN, args = q(iface) .. " --all", tool = "iwpriv", match = function(out)
				return out:lower():find("spectrum", 1, true) ~= nil
			end },
		})
	end
	if MTWIFI_CFG_BIN then
		probes.mtwifi_cfg = probe_first({
			{ bin = MTWIFI_CFG_BIN, args = "--help", tool = "mtwifi-cfg", match = function(out)
				local low = out:lower()
				return low:find("mtwifi", 1, true) ~= nil or low:find("channel", 1, true) ~= nil or low:find("temperature", 1, true) ~= nil or low:find("apply", 1, true) ~= nil
			end },
		})
	end
	if IWPRIV_BIN and iface then
		probes.temperature = probe_first({
			{ bin = IWPRIV_BIN, args = q(iface) .. " get_temperature", tool = "iwpriv", match = function(out)
				return out:match("[Tt]emperature[^%d%-]*([%-]?%d+)") ~= nil
			end },
		})
	end
	if IWINFO_BIN and iface then
		probes.channel = probe_first({
			{ bin = IWINFO_BIN, args = q(iface) .. " info", tool = "iwinfo", match = function(out)
				return out:match("Channel:%s*([%d]+)") ~= nil
			end },
		})
		probes.power = probe_first({
			{ bin = IWINFO_BIN, args = q(iface) .. " info", tool = "iwinfo", match = function(out)
				return out:match("Tx%-Power:%s*([%d]+)") ~= nil
			end },
		})
	end
	local wc = find_bin("wappctrl")
	if wc then
		probes.wappctrl = probe_first({
			{ bin = wc, args = "-h", tool = "wappctrl", match = function(out) return out:lower():find("wapp", 1, true) ~= nil end },
			{ bin = wc, args = "--help", tool = "wappctrl", match = function(out) return out:lower():find("wapp", 1, true) ~= nil end },
		})
	end
	for _, s in ipairs(MAP_SERVICES) do
		local initd = "/etc/init.d/" .. s
		if fs.access(initd, "x") then
			local code, out = sh(initd .. " running")
			probes[s] = {
				status = code == 0 and "running" or "available",
				exit_code = code,
				command = initd .. " running",
				tool = "init.d",
				output = clean_text(out):sub(1, 400),
			}
		else
			probes[s] = { status = "unavailable", reason = "missing_service" }
		end
	end
	return probes
end

local function status()
	local w, err = ubus_call("status")
	if not w then return { ok = false, error = err or "ubus network.wireless 不可用" } end
	local radios, stations, station_count = {}, {}, 0
	for _, r in ipairs(extract_radios(w)) do
		local ri = {
			id = r.name or r.id,
			type = r.type,
			path = r.path,
			hwmode = r.hwmode,
			channel = r.channel,
			htmode = r.htmode,
			txpower = r.txpower,
			country = r.country,
			disabled = r.disabled == true,
			ifaces = {},
		}
		local ifs = r.ifaces or {}
		if type(ifs) == "table" then
			for _, f in ipairs(ifs) do
				if type(f) == "table" then
					local net = f.network
					if type(net) == "table" then net = table.concat(net, " ") end
					local fi = {
						ifname = f.ifname,
						ssid = clean_text(f.ssid or ""),
						mode = f.mode,
						network = net,
						encryption = f.encryption,
						macaddr = f.macaddr,
						disabled = f.disabled == true,
					}
					ri.ifaces[#ri.ifaces + 1] = fi
					if IWINFO_BIN and f.ifname and not f.disabled and (f.mode == "ap") then
						local pok, pc, po = pcall(sh, IWINFO_BIN .. " " .. q(f.ifname) .. " assoclist")
						if pok and pc == 0 then
							local list = parse_assoclist(po or "")
							stations[f.ifname] = list
							station_count = station_count + #list
						end
					end
					if IWINFO_BIN and f.ifname and not f.disabled and f.mode == "sta" then
						local pok, pc, po = pcall(sh, IWINFO_BIN .. " " .. q(f.ifname) .. " info")
						if pok and pc == 0 then
							fi.upstream = {
								 ssid = clean_text(po:match("ESSID%s*:%s*(.-)%s*\n") or ""),
							 bssid = po:match("Access Point%s*:%s*([%x:]+)"),
							 signal = tonumber(po:match("Signal%s*:%s*(-?%d+)") or nil),
							 channel = tonumber(po:match("Channel%s*:%s*(%d+)") or nil),
							}
						end
					end
				end
			end
		end
		radios[#radios + 1] = ri
	end
	return {
		ok = true,
		up = w.up == true,
		running = w.running == true,
		radios = radios,
		stations = stations,
		station_count = station_count,
		mtwifi = fs.access("/sys/module/mt_wifi"),
		wireless_ifaces = wireless_iface_names(),
	}
end

local function capabilities()
	local map_present = fs.access(MAP_DIR .. "/1905d.cfg") or fs.access(MAP_DIR .. "/mapd_cfg")
	local comps = {}
	for _, n in ipairs(MAP_COMPONENTS) do
		local p = find_bin(n)
		comps[n] = p ~= nil
	end
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do
		svcs[n] = fs.access("/etc/init.d/" .. n, "x")
	end
	local has_svc = svcs.mapd or svcs.wapp or svcs.bs20
	local probes = runtime_probes()
	return {
		ok = true,
		version = plugin_version(),
		hardware = {
			mtwifi = fs.access("/sys/module/mt_wifi"),
			chipset = fs.access("/sys/module/mt_wifi") and "MT7981/MT7986" or nil,
			macaddr = read_file("/sys/class/net/wlan0/address"),
		},
		tools = {
			uci = UCI_BIN ~= nil,
			wifi = WIFI_BIN ~= nil,
			iwinfo = IWINFO_BIN ~= nil,
			tar = TAR_BIN ~= nil,
			sha256 = SHA_BIN ~= nil,
			logread = LOGREAD_BIN ~= nil,
			l1util = find_bin("l1util") ~= nil,
			mtwifi_cfg = MTWIFI_CFG_BIN ~= nil,
		},
		map = {
			config = map_present,
			components = comps,
			services = svcs,
			has_managed_service = has_svc,
			wappctrl_probe = probes.wappctrl,
			probes = probes,
		},
		wireless_writable = fs.access("/etc/config/wireless", "w"),
		limits = { ap_max = 16, apcli_max = 1 },
		backend = "mtk-dash2",
	}
end

local function topology()
	local cfg = map_config_summary()
	local procs = running_processes()
	local w = ubus_call("status")
	local radios = {}
	if w then
		for _, r in ipairs(extract_radios(w)) do
			local ifs = {}
			for _, f in ipairs(r.ifaces or {}) do
				if type(f) == "table" then
					ifs[#ifs + 1] = { ifname = f.ifname, ssid = clean_text(f.ssid or ""), mode = f.mode, disabled = f.disabled == true }
				end
			end
			radios[#radios + 1] = { id = r.name or r.id, channel = r.channel, hwmode = r.hwmode, ifaces = ifs }
		end
	end
	local comps = {}
	for _, n in ipairs(MAP_COMPONENTS) do comps[n] = find_bin(n) ~= nil end
	local svcs = {}
	for _, n in ipairs(MAP_SERVICES) do svcs[n] = fs.access("/etc/init.d/" .. n, "x") end
	local present = #cfg > 0 and cfg[1].present or false
	for _, e in ipairs(cfg) do if e.present then present = true end end
	local probes = runtime_probes()
	return {
		ok = true,
		available = present,
		components = comps,
		services = svcs,
		probes = probes,
		processes = procs,
		config = cfg,
		radios = radios,
		complete = false,
		hint = "MAP 闭源工具仅做固定查询与解析，拓扑可能不完整；运行时能力以 probes 状态为准",
	}
end

local function diagnostics()
	local steps = {}
	local function add(name, cmd, ok, extra)
		local s = { name = name, command = cmd, ok = ok == true, exit_code = 0 }
		for k, v in pairs(extra or {}) do s[k] = v end
		steps[#steps + 1] = s
	end

	local w, err = ubus_call("status")
	if w then
		add("无线状态", "ubus network.wireless status", true, { output = json.encode(redact_table(w)) })
	else
		add("无线状态", "ubus network.wireless status", false, { error = err or "调用失败" })
	end

	if UCI_BIN then
		local code, out = sh(UCI_BIN .. " show wireless")
		add("UCI 无线配置", UCI_BIN .. " show wireless", code == 0, { exit_code = code, output = redact_text(out) })
	else
		add("UCI 无线配置", "uci", false, { error = "缺少 uci 命令" })
	end

	local dat = {}
	for n in safe_dir("/etc/wireless") do
		local p = "/etc/wireless/" .. n
		local st = fs.stat(p, "size") or 0
		dat[#dat + 1] = { name = n, bytes = st }
	end
	table.sort(dat, function(a, b) return a.name < b.name end)
	add("DAT 文件", "/etc/wireless", true, { files = dat })

	if LOGREAD_BIN then
		local code, out = sh(LOGREAD_BIN .. " -l 120")
		local filtered = {}
		for line in out:gmatch("[^\r\n]+") do
			if line:match("mt%-wifi") or line:match("wapp") or line:match("bs20") or line:match("1905") or line:match("mt7615") or line:match("ra0") or line:match("apcli") or line:match("mapd") then
				filtered[#filtered + 1] = clean_text(redact_line(line))
			end
		end
		add("系统日志(过滤)", LOGREAD_BIN .. " -l 120", code == 0, { exit_code = code, output = table.concat(filtered, "\n") })
	else
		add("系统日志", "logread", false, { error = "缺少 logread" })
	end

	local mapsum = map_config_summary()
	add("MAP 配置", "/etc/map/*", true, { files = mapsum })

	local ifaces = wireless_iface_names()
	add("无线接口", "/sys/class/net", true, { interfaces = ifaces })

	local probes = runtime_probes()
	add("运行时能力探测", "固定只读探测", true, { probes = probes })

	return { ok = true, redacted = true, collected = os.date("%Y-%m-%dT%H:%M:%S"), probes = probes, steps = steps }
end

