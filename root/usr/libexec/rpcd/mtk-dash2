local function valid_value(spec, value)
	if type(value) ~= "string" then return nil end
	value = value:gsub("%s+$", "")
	if value == "" then return nil end
	if spec.max and #value > spec.max then return nil end
	if spec.kind == "enum" then
		for _, x in ipairs(spec.values) do if x == value then return value end end
		return nil
	elseif spec.kind == "int" then
		local n = tonumber(value)
		if not n or n % 1 ~= 0 then return nil end
		if spec.min and n < spec.min then return nil end
		if spec.max and n > spec.max then return nil end
		return tostring(n)
	elseif spec.kind == "bool" then
		if value == "1" or value == "0" then return value end
		return nil
	elseif spec.kind == "mac" then
		if value:match("^[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]$") then return value end
		return nil
	elseif spec.kind == "maclist" then
		local count = 0
		for mac in value:gmatch("[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]") do count = count + 1 end
		if count == 0 or value:gsub("[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]", ""):match("%S") then return nil end
		return value
	elseif spec.kind == "psk" then
		if #value >= 8 and #value <= 63 then return value end
		return nil
	end
	if spec.check and not spec.check(value) then return nil end
	return value
end

local function get_wireless_config()
	local devices, ifaces = {}, {}
	local function add_section(name, typ)
		local list = typ == "wifi-device" and devices or (typ == "wifi-iface" and ifaces or nil)
		if not list then return nil end
		local sec = { name = name, type = typ }
		list[#list + 1] = sec
		return sec
	end
	local values = uci_get_wireless_values()
	if values then
		for name, sec in pairs(values) do
			if type(sec) == "table" and type(sec[".type"]) == "string" then
				local s = add_section(name, sec[".type"])
				if s then
					for k, v in pairs(sec) do
						if k:sub(1, 1) ~= "." then
							if type(v) == "table" then v = table.concat(v, " ") end
							v = tostring(v)
							if k == "key" or k == "psk" then
								if v ~= "" then s.key_set = true end
							elseif not is_sensitive(k) then
								s[k] = v
							end
						end
					end
				end
			end
		end
	else
		if not UCI_BIN then return { ok = false, error = "缺少 uci 命令且 ubus uci 不可用", exit_code = 127 } end
		local code, out = sh(UCI_BIN .. " show wireless")
		if code ~= 0 then return { ok = false, error = "读取 wireless 配置失败", exit_code = code } end
		for line in out:gmatch("[^\r\n]+") do
			local secname, value = line:match("^wireless%.([%w_@%[%]%.%-]+)=(.*)$")
			if secname then
				local v = value:gsub("^'(.*)'$", "%1")
				local sname, opt = secname:match("^(.+)%.(%w+)$")
				if sname then
					local found = nil
					for _, l in ipairs({ devices, ifaces }) do
						for _, s in ipairs(l) do
							if s.name == sname then found = s break end
						end
						if found then break end
					end
					if found then
						if opt == "key" or opt == "psk" then
							if v ~= "" then found.key_set = true end
						elseif not is_sensitive(opt) then
							found[opt] = v
						end
					end
				else
					add_section(secname, v)
				end
			end
		end
	end
	table.sort(devices, function(a, b) return a.name < b.name end)
	table.sort(ifaces, function(a, b) return (a.device or "") < (b.device or "") end)
	return { ok = true, devices = devices, ifaces = ifaces }
end

local function backup_wireless_uci()
	if not UCI_BIN then return nil, "缺少 uci 命令" end
	local tmp = os.tmpname()
	local code = sh(UCI_BIN .. " export wireless >" .. q(tmp) .. " 2>&1")
	if code ~= 0 then os.remove(tmp); return nil, "导出 wireless 失败" end
	return tmp, nil
end

local function restore_wireless_uci(tmp)
	if not tmp then return end
	sh(UCI_BIN .. " import <" .. q(tmp))
	sh(UCI_BIN .. " commit wireless")
	os.remove(tmp)
end

local function commit_and_apply(apply, before_verified)
	local c1 = sh(UCI_BIN .. " commit wireless")
	if c1 ~= 0 then return { ok = false, error = "uci commit 失败", exit_code = c1 } end
	local res = { ok = true, written = true, exit_code = 0 }
	if apply then
		if not WIFI_BIN then res.error = "已写入 UCI，但缺少 wifi 命令，未应用"; res.applied = false; return res end
		local c2 = sh(WIFI_BIN .. " reload")
		res.applied = c2 == 0
		res.apply_exit_code = c2
		if not res.applied then res.error = "无线应用失败"; res.rolled_back = false end
	end
	if before_verified and not (apply and not res.applied) then
		local after = status()
		if after and after.up == false then
			res.error = "应用后无线状态复核异常"
		end
	end
	return res
end

local function update_device(args)
	args = args or {}
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令", exit_code = 127 } end
	local device = args.device
	if type(device) ~= "string" or not device:match("^[%w_.-]+$") then return { ok = false, error = "device 参数非法" } end
	if type(args.values) ~= "table" or next(args.values) == nil then return { ok = false, error = "values 参数非法" } end
	local c0, typ = sh(UCI_BIN .. " get wireless." .. device)
	if c0 ~= 0 or not typ:find("wifi-device", 1, true) then return { ok = false, error = "device 不存在或不是 wifi-device", exit_code = c0 } end
	local rb, err = backup_wireless_uci()
	if not rb then return { ok = false, error = err } end
	local changed = {}
	for k, v in pairs(args.values) do
		local spec = DEVICE_VALUE_FIELDS[k]
		local nv = spec and valid_value(spec, v)
		if not nv then restore_wireless_uci(rb); return { ok = false, error = "字段不在白名单或值非法: " .. tostring(k) } end
		local c = sh(UCI_BIN .. " set wireless." .. device .. "." .. k .. "=" .. q(nv))
		if c ~= 0 then restore_wireless_uci(rb); return { ok = false, error = "UCI 写入失败: " .. k, exit_code = c } end
		changed[k] = nv
	end
	local res = commit_and_apply(args.apply == true, true)
	res.device = device
	res.changed = changed
	if res.error then res.rolled_back = false end
	if res.error then
		restore_wireless_uci(rb)
		res.rolled_back = true
		res.rollback_verified = get_wireless_config().ok
	end
	return res
end

local function update_vif(args)
	args = args or {}
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令", exit_code = 127 } end
	local iface = args.iface
	if type(iface) ~= "string" or not iface:match("^[%w_@%[%]%.%-]+$") then return { ok = false, error = "iface 参数非法" } end
	if type(args.values) ~= "table" or next(args.values) == nil then return { ok = false, error = "values 参数非法" } end
	local c0, typ = sh(UCI_BIN .. " get wireless." .. iface)
	if c0 ~= 0 or not typ:find("wifi-iface", 1, true) then return { ok = false, error = "iface 不存在或不是 wifi-iface", exit_code = c0 } end
	local rb, err = backup_wireless_uci()
	if not rb then return { ok = false, error = err } end
	local changed = {}
	local want_enc = args.values.encryption
	local ec_enc, cur_enc_out = sh(UCI_BIN .. " get wireless." .. iface .. ".encryption")
	local cur_enc = ec_enc == 0 and cur_enc_out:gsub("%s+$", "") or "none"
	for k, v in pairs(args.values) do
		local spec = VIF_VALUE_FIELDS[k]
		local nv = spec and valid_value(spec, v)
		if not nv then restore_wireless_uci(rb); return { ok = false, error = "字段不在白名单或值非法: " .. tostring(k) } end
		local c = sh(UCI_BIN .. " set wireless." .. iface .. "." .. k .. "=" .. q(nv))
		if c ~= 0 then restore_wireless_uci(rb); return { ok = false, error = "UCI 写入失败: " .. k, exit_code = c } end
		changed[k] = nv
	end
	local enc_changed = want_enc ~= nil and want_enc ~= cur_enc
	if enc_changed and want_enc ~= "none" and not args.values.key then
		local kc, ko = sh(UCI_BIN .. " get wireless." .. iface .. ".key")
		local has_key = kc == 0 and ko:gsub("%s+$", "") ~= ""
		if not has_key then
			restore_wireless_uci(rb)
			return { ok = false, error = "切换到加密模式时必须同时提供 key" }
		end
	end
	if enc_changed and want_enc == "none" then
		sh(UCI_BIN .. " delete wireless." .. iface .. ".key")
		changed.key = "(已移除)"
	end
	local res = commit_and_apply(args.apply == true, true)
	res.iface = iface
	res.changed = changed
	if res.error then
		restore_wireless_uci(rb)
		res.rolled_back = true
		res.rollback_verified = get_wireless_config().ok
	end
	return res
end

local function add_vif(args)
	args = args or {}
	if not UCI_BIN then return { ok = false, error = "缺少 uci 命令", exit_code = 127 } end
	local device = args.device
	if type(device) ~= "string" or not device:match("^[%w_.-]+$") then return { ok = false, error = "device 参数非法" } end
	local mode = args.mode == "sta" and "sta" or "ap"
	local ssid = args.ssid
	local enc = args.encryption or "none"
	local key = args.key or ""
	local network = args.network or "lan"
	local bssid = args.bssid or ""
	if type(ssid) ~= "string" or ssid == "" or #ssid > 32 then return { ok = false, error = "ssid 参数非法" } end
	if not valid_value(VIF_VALUE_FIELDS.encryption, enc) then return { ok = false, error = "encryption 参数非法" } end
	if enc ~= "none" then
		if type(key) ~= "string" or not valid_value(VIF_VALUE_FIELDS.key, key) then return { ok = false, error = "加密模式下 key 必须为 8-63 位" } end
	end
	if type(network) ~= "string" or network == "" or #network > 64 then return { ok = false, error = "network 参数非法" } end
	if bssid ~= "" and not valid_value(VIF_VALUE_FIELDS.bssid, bssid) then return { ok = false, error = "bssid 参数非法" } end
	local c0, typ = sh(UCI_BIN .. " get wireless." .. device)
	if c0 ~= 0 or not typ:find("wifi-device", 1, true) then return { ok = false, error = "device 不存在或不是 wifi-device", exit_code = c0 } end
	local cur = get_wireless_config()
	local ap_count, sta_count = 0, 0
	for _, f in ipairs(cur.ifaces or {}) do
		if f.device == device then
			if f.mode == "ap" then ap_count = ap_count + 1 end
			if f.mode == "sta" then sta_count = sta_count + 1 end
		end
	end
	if mode == "ap" and ap_count >= 16 then return { ok = false, error = "AP 数量已达上限 16" } end
	if mode == "sta" and sta_count >= 1 then return { ok = false, error = "mtwifi-cfg 每个射频仅支持 1 个 APCLI/STA 接口" } end
	local rb, err = backup_wireless_uci()
	if not rb then return { ok = false, error = err } end
	local c1, name = sh(UCI_BIN .. " add wireless wifi-iface")
	name = name:gsub("%s+$", "")
	if c1 ~= 0 or name == "" then restore_wireless_uci(rb); return { ok = false, error = "创建 wifi-iface 失败", exit_code = c1 } end
	local sets = {
		{ "device", device }, { "mode", mode }, { "ssid", ssid },
		{ "encryption", enc }, { "network", network },
	}
	if enc ~= "none" then sets[#sets + 1] = { "key", key } end
	if bssid ~= "" then sets[#sets + 1] = { "bssid", bssid } end
	for _, s in ipairs(sets) do
		local c = sh(UCI_BIN .. " set wireless." .. name .. "." .. s[1] .. "=" .. q(s[2]))
		if c ~= 0 then restore_wireless_uci(rb); return { ok = false, error = "设置 " .. s[1] .. " 失败", exit_code = c } end
	end
	local res = commit_and_apply(args.apply == true, true)
	res.iface = name
	res.created = { device = device, mode = mode, ssid = ssid, encryption = enc, network = network }
	if res.error then
		restore_wireless_uci(rb)
		res.rolled_back = true
	end
	return res
end

