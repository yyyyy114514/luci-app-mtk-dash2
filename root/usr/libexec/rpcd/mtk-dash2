local SENSITIVE_WORDS = {
	"key", "psk", "pass", "secret", "password", "sae", "wep", "pin",
	"preSharedKey", "pre_shared_key", "wpapsk", "wpa_key", "repeater",
	"k1", "k2", "pmk", "dpp", "bootstrap", "authpass", "cred",
}

local function is_sensitive(key)
	local k = tostring(key or ""):lower()
	for _, w in ipairs(SENSITIVE_WORDS) do
		if k:find(w, 1, true) then return true end
	end
	return false
end

local function clean_text(s)
	if type(s) ~= "string" then return "" end
	s = s:gsub("\0", " ")
	s = s:gsub("[\1-\8\11\12\14-\31\127]", " ")
	local t, i, n = {}, 1, #s
	while i <= n do
		local b = s:byte(i)
		if b < 128 then
			t[#t + 1] = string.char(b)
			i = i + 1
		elseif b >= 192 and b <= 244 then
			local nb = 1
			if b >= 240 then nb = 3
			elseif b >= 224 then nb = 2
			end
			if i + nb <= n then
				local okc = true
				for j = i + 1, i + nb do
					local c = s:byte(j)
					if not (c >= 128 and c <= 191) then okc = false break end
				end
				if okc then
					t[#t + 1] = s:sub(i, i + nb)
					i = i + nb + 1
				else
					i = i + 1
				end
			else
				i = i + 1
			end
		else
			i = i + 1
		end
	end
	s = table.concat(t)
	if #s > 20000 then s = s:sub(1, 20000) end
	return s
end

local function redact_line(line)
	line = line:gsub("(option%s+([%w_]+)%s*['\"])([^'\"]*)(['\"])", function(pre, k, v, post)
		if is_sensitive(k) then return pre .. REDACTED .. post end
		return pre .. v .. post
	end)
	line = line:gsub("(^|[^%w_])([%w_.-]+)=(['\"]?)([^%s'\"]*)(['\"]?)", function(prefix, k, q1, v, q2)
		if is_sensitive(k) then return prefix .. k .. "=" .. q1 .. REDACTED .. q2 end
		return prefix .. k .. "=" .. q1 .. v .. q2
	end)
	return line
end

local function redact_text(text)
	if type(text) ~= "string" then return "" end
	local out = {}
	for line in text:gmatch("[^\r\n]*") do
		out[#out + 1] = redact_line(line)
	end
	return table.concat(out, "\n")
end

local function redact_table(t)
	if type(t) ~= "table" then return t end
	local r = {}
	for k, v in pairs(t) do
		if type(k) == "string" and is_sensitive(k) then
			r[k] = "***"
		elseif type(v) == "table" then
			r[k] = redact_table(v)
		else
			r[k] = v
		end
	end
	return r
end

local BIN_DIRS = { "/usr/sbin", "/usr/bin", "/sbin", "/bin", "/usr/libexec" }
local function find_bin(name)
	for _, d in ipairs(BIN_DIRS) do
		local p = d .. "/" .. name
		if fs.access(p, "x") then return p end
	end
	return nil
end

